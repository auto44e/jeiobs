# blob size: exactly 64 MiB is read (its 64 MiB string then makes it invalid, so a role with
# secrets omits it without an OUTFILE); 64 MiB + 1 is refused. Written here, without copies.
string(REPEAT "a" 67108856 _jw_s)
file(WRITE "${WORK_DIR}/redact/blob-64mib.json" "{\"x\":\"${_jw_s}\"}")
