file(WRITE "${WORK_DIR}/redact/nul-encoder.json" "${_jw_x}")
set(_jw_x "{\"rate_control\":\"CBR\"}${_jw_nul}")
file(WRITE "${WORK_DIR}/redact/nul-trailing-encoder.json" "${_jw_x}")
set(_jw_want_nul-service "^.*22610062227d7d$")
set(_jw_want_nul-encoder "^.*22610062227d$")
set(_jw_want_nul-trailing-encoder "^.*7d00$")
