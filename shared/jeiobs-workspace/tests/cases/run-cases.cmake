# cases.txt

# Absolute path of a report= or out= file: ${WORK}/... is generated above, anything else is
# relative to CASES_DIR.
function(_jw_case_file out rel)
  if(rel MATCHES "^[$][{]WORK[}]/(.+)$")
    set(${out} "${WORK_DIR}/${CMAKE_MATCH_1}" PARENT_SCOPE)
  else()
    set(${out} "${CASES_DIR}/${rel}" PARENT_SCOPE)
  endif()
endfunction()

# The name of such a file in messages: relative to CASES_DIR, or ${WORK}/...
function(_jw_case_name out path)
  string(LENGTH "${WORK_DIR}/" l)
  string(SUBSTRING "${path}" 0 ${l} p)
  if(p STREQUAL "${WORK_DIR}/")
    string(SUBSTRING "${path}" ${l} -1 p)
    set(${out} "\${WORK}/${p}" PARENT_SCOPE)
  else()
    file(RELATIVE_PATH p "${CASES_DIR}" "${path}")
    set(${out} "${p}" PARENT_SCOPE)
  endif()
endfunction()

file(READ "${CASES_DIR}/cases.txt" _jw_text)
string(REPLACE "\r" "" _jw_text "${_jw_text}")
foreach(_jw_bad IN ITEMS semicolon bracket-open bracket-close backslash)
  set(_jw_ch_semicolon ";")
  set(_jw_ch_bracket-open "[")
  set(_jw_ch_bracket-close "]")
  set(_jw_ch_backslash "\\")
  string(FIND "${_jw_text}" "${_jw_ch_${_jw_bad}}" _jw_pos)
  if(NOT _jw_pos EQUAL -1)
    message(FATAL_ERROR "cases.txt: no ${_jw_bad} allowed (byte offset ${_jw_pos}), use %XX")
  endif()
endforeach()
# Every line gets a ">" prefix so that empty lines stay list elements and line numbers hold.
string(REPLACE "\n" ";>" _jw_lines ">${_jw_text}")

set(_jw_count 0)
set(_jw_names "")
set(_jw_lineno 0)
foreach(_jw_raw IN LISTS _jw_lines)
  math(EXPR _jw_lineno "${_jw_lineno} + 1")
  string(SUBSTRING "${_jw_raw}" 1 -1 _jw_line)
  string(STRIP "${_jw_line}" _jw_line)
  if(_jw_line STREQUAL "" OR _jw_line MATCHES "^#")
    continue()
  endif()
  set(_jw_rest "${_jw_line}")
  set(_jw_nsep 0)
  foreach(_jw_k RANGE 1 3)
    string(FIND "${_jw_rest}" " | " _jw_p)
    if(_jw_p EQUAL -1)
      break()
    endif()
    string(SUBSTRING "${_jw_rest}" 0 ${_jw_p} _jw_f)
    string(STRIP "${_jw_f}" _jw_field${_jw_k})
    math(EXPR _jw_p "${_jw_p} + 3")
    string(SUBSTRING "${_jw_rest}" ${_jw_p} -1 _jw_rest)
    set(_jw_nsep ${_jw_k})
  endforeach()
  string(STRIP "${_jw_rest}" _jw_rest)
  if(_jw_nsep EQUAL 2)
    set(_jw_field3 "${_jw_rest}")
    set(_jw_field4 "")
  elseif(_jw_nsep EQUAL 3)
    set(_jw_field4 "${_jw_rest}")
  else()
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: expected NAME | EXIT | EXPECTED | ARGS")
  endif()
  if(NOT _jw_field1 MATCHES "^[A-Za-z0-9._-]+(@posix)?$")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: bad case name '${_jw_field1}'")
  endif()
  if(_jw_field1 IN_LIST _jw_names)
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: duplicate case name '${_jw_field1}'")
  endif()
  if(NOT _jw_field2 MATCHES "^[0-9]+(,[0-9]+)*$")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: bad exit code '${_jw_field2}'")
  endif()
  string(REPLACE "," ";" _jw_exits "${_jw_field2}")
  if(_jw_field3 STREQUAL "")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: empty expectation")
  endif()
  if(_jw_field3 MATCHES "^[?]")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: no \"?\" prefix: an ERR line must be on stdout")
  endif()
  # plan cases: tree=NAME builds fixtures/plan/trees/NAME.tree as ${TREE}; uids=random checks
  # random uids; EXPECTED may also be entries=N, or @FILE,FILE,... (one of them, in canonical form)
  set(_jw_plan FALSE)
  set(_jw_tree "")
  set(_jw_uids "")
  if(_jw_field4 MATCHES "^plan( |$)")
    set(_jw_plan TRUE)
    string(REGEX REPLACE " +" ";" _jw_toks "${_jw_field3}")
    set(_jw_keep "")
    foreach(_jw_t IN LISTS _jw_toks)
      if(_jw_t MATCHES "^tree=([A-Za-z0-9._-]+)$")
        set(_jw_tree "${CMAKE_MATCH_1}")
        if(NOT EXISTS "${CASES_DIR}/fixtures/plan/trees/${_jw_tree}.tree")
          message(FATAL_ERROR "cases.txt:${_jw_lineno}: fixtures/plan/trees/${_jw_tree}.tree not found")
        endif()
      elseif(_jw_t STREQUAL "uids=random")
        set(_jw_uids random)
      else()
        list(APPEND _jw_keep "${_jw_t}")
      endif()
    endforeach()
    list(JOIN _jw_keep " " _jw_field3)
    if(_jw_field3 STREQUAL "")
      message(FATAL_ERROR "cases.txt:${_jw_lineno}: empty expectation")
    endif()
    if(_jw_field4 MATCHES "[$][{]TREE[}]" AND _jw_tree STREQUAL "")
      message(FATAL_ERROR "cases.txt:${_jw_lineno}: \${TREE} needs tree=NAME")
    endif()
    if(_jw_uids STREQUAL "random" AND NOT _jw_field3 MATCHES "^@")
      message(FATAL_ERROR "cases.txt:${_jw_lineno}: uids=random needs @FILE")
    endif()
  elseif(_jw_field3 MATCHES "(^| )(tree|uids|entries)=" OR _jw_field4 MATCHES "[$][{]TREE[}]")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: tree=, uids=, entries= and \${TREE} are only for plan cases")
  endif()
  if(_jw_field3 MATCHES "^@(.+)$")
    string(REPLACE "," ";" _jw_fl "${CMAKE_MATCH_1}")
    list(LENGTH _jw_fl _jw_n)
    if(_jw_n GREATER 1 AND NOT _jw_plan)
      message(FATAL_ERROR "cases.txt:${_jw_lineno}: several @FILEs are only for plan cases")
    endif()
    foreach(_jw_f IN LISTS _jw_fl)
      set(_jw_f "${CASES_DIR}/${_jw_f}")
      if(NOT EXISTS "${_jw_f}")
        message(FATAL_ERROR "cases.txt:${_jw_lineno}: '${_jw_f}' not found")
      endif()
      file(READ "${_jw_f}" _jw_json)
      string(JSON _jw_t ERROR_VARIABLE _jw_e TYPE "${_jw_json}")
      if(NOT _jw_e STREQUAL "NOTFOUND" OR NOT _jw_t STREQUAL "OBJECT")
        message(FATAL_ERROR "cases.txt:${_jw_lineno}: '${_jw_f}' is not a JSON object: ${_jw_e}")
      endif()
    endforeach()
  endif()
  # redact cases: report=FILE[,FILE...] and out=FILE tokens of EXPECTED check the written files
  # (FILE is relative to this directory, or ${WORK}/... for a file generated above); timeout=N
  # sets the case's timeout in seconds
  set(_jw_redact FALSE)
  set(_jw_report "")
  set(_jw_outx "")
  set(_jw_tmo "${JW_CASE_TIMEOUT}")
  if(_jw_field4 MATCHES "^redact( |$)")
    set(_jw_redact TRUE)
    string(REGEX REPLACE " +" ";" _jw_toks "${_jw_field3}")
    set(_jw_keep "")
    foreach(_jw_t IN LISTS _jw_toks)
      if(_jw_t MATCHES "^report=(.+)$")
        string(REPLACE "," ";" _jw_report "${CMAKE_MATCH_1}")
      elseif(_jw_t MATCHES "^out=(.+)$")
        set(_jw_outx "${CMAKE_MATCH_1}")
      elseif(_jw_t MATCHES "^timeout=([1-9][0-9]*)$")
        set(_jw_tmo "${CMAKE_MATCH_1}")
      else()
        list(APPEND _jw_keep "${_jw_t}")
      endif()
    endforeach()
    list(JOIN _jw_keep " " _jw_field3)
    if("0" IN_LIST _jw_exits AND _jw_report STREQUAL "")
      message(FATAL_ERROR "cases.txt:${_jw_lineno}: a redact case that succeeds needs report=FILE or report=*")
    endif()
    if(NOT _jw_report STREQUAL "" AND NOT _jw_report STREQUAL "*")
      set(_jw_abs "")
      foreach(_jw_f IN LISTS _jw_report)
        _jw_case_file(_jw_f "${_jw_f}")
        if(NOT EXISTS "${_jw_f}")
          message(FATAL_ERROR "cases.txt:${_jw_lineno}: '${_jw_f}' not found")
        endif()
        file(READ "${_jw_f}" _jw_json)
        string(JSON _jw_t ERROR_VARIABLE _jw_e TYPE "${_jw_json}")
        if(NOT _jw_e STREQUAL "NOTFOUND" OR NOT _jw_t STREQUAL "OBJECT")
          message(FATAL_ERROR "cases.txt:${_jw_lineno}: '${_jw_f}' is not a JSON object: ${_jw_e}")
        endif()
        list(APPEND _jw_abs "${_jw_f}")
      endforeach()
      set(_jw_report "${_jw_abs}")
    endif()
    if(NOT _jw_outx STREQUAL "")
      _jw_case_file(_jw_outx "${_jw_outx}")
      if(NOT EXISTS "${_jw_outx}")
        message(FATAL_ERROR "cases.txt:${_jw_lineno}: '${_jw_outx}' not found")
      endif()
    endif()
  elseif(_jw_field3 MATCHES "(^| )(report|out|timeout)=")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: report=, out= and timeout= are only for redact cases")
  endif()
  list(APPEND _jw_names "${_jw_field1}")
  set(_jw_case${_jw_count}_name "${_jw_field1}")
  set(_jw_case${_jw_count}_exit "${_jw_field2}")
  set(_jw_case${_jw_count}_expect "${_jw_field3}")
  set(_jw_case${_jw_count}_args "${_jw_field4}")
  set(_jw_case${_jw_count}_line "${_jw_lineno}")
  set(_jw_case${_jw_count}_redact "${_jw_redact}")
  set(_jw_case${_jw_count}_report "${_jw_report}")
  set(_jw_case${_jw_count}_outx "${_jw_outx}")
  set(_jw_case${_jw_count}_timeout "${_jw_tmo}")
  set(_jw_case${_jw_count}_plan "${_jw_plan}")
  set(_jw_case${_jw_count}_tree "${_jw_tree}")
  set(_jw_case${_jw_count}_uids "${_jw_uids}")
  math(EXPR _jw_count "${_jw_count} + 1")
endforeach()
if(_jw_count EQUAL 0)
  message(FATAL_ERROR "cases.txt: no cases")
endif()

# ------------------------------------------------------------------------------------------------
# helpers

# Decodes one ARGS token: "" is the empty string, %XX a byte, ${NAME} a JW_VAR_NAME value.
function(_jw_decode out token line)
  if(token STREQUAL "\"\"")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  set(res "")
  set(rest "${token}")
  while(1)
    string(FIND "${rest}" "%" p)
    if(p EQUAL -1)
      string(APPEND res "${rest}")
      break()
    endif()
    string(SUBSTRING "${rest}" 0 ${p} pre)
    string(APPEND res "${pre}")
    math(EXPR q "${p} + 1")
    string(SUBSTRING "${rest}" ${q} 2 hex)
    if(NOT hex MATCHES "^[0-9A-Fa-f][0-9A-Fa-f]$")
      message(FATAL_ERROR "cases.txt:${line}: bad escape in '${token}'")
    endif()
    math(EXPR code "0x${hex}")
    if(code EQUAL 0)
      message(FATAL_ERROR "cases.txt:${line}: %00 cannot be passed as an argument")
    endif()
    string(ASCII ${code} ch)
    string(APPEND res "${ch}")
    math(EXPR q "${p} + 3")
    string(SUBSTRING "${rest}" ${q} -1 rest)
  endwhile()
  foreach(var IN LISTS JW_VARS)
    string(REPLACE "\${${var}}" "${JW_VAR_${var}}" res "${res}")
  endforeach()
  string(FIND "${res}" "\${" p)
  if(NOT p EQUAL -1)
    message(FATAL_ERROR "cases.txt:${line}: unknown variable in '${token}'")
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Runs JW_CHECK with _jw_a0 .. _jw_a<argc-1> and the timeout _jw_timeout of the case; sets _jw_rc,
# _jw_out and _jw_err.
function(_jw_exec argc)
  set(o WORKING_DIRECTORY "${CASES_DIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err
        TIMEOUT ${_jw_timeout} ENCODING UTF-8)
  set(c "${JW_CHECK}")
  if(argc EQUAL 0)
    execute_process(COMMAND "${c}" ${o})
  elseif(argc EQUAL 1)
    execute_process(COMMAND "${c}" "${_jw_a0}" ${o})
  elseif(argc EQUAL 2)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" ${o})
  elseif(argc EQUAL 3)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" ${o})
  elseif(argc EQUAL 4)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" ${o})
  elseif(argc EQUAL 5)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" "${_jw_a4}" ${o})
  elseif(argc EQUAL 6)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" "${_jw_a4}"
                            "${_jw_a5}" ${o})
  elseif(argc EQUAL 7)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" "${_jw_a4}"
                            "${_jw_a5}" "${_jw_a6}" ${o})
  elseif(argc EQUAL 8)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" "${_jw_a4}"
                            "${_jw_a5}" "${_jw_a6}" "${_jw_a7}" ${o})
  elseif(argc EQUAL 9)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" "${_jw_a4}"
                            "${_jw_a5}" "${_jw_a6}" "${_jw_a7}" "${_jw_a8}" ${o})
  elseif(argc EQUAL 10)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" "${_jw_a4}"
                            "${_jw_a5}" "${_jw_a6}" "${_jw_a7}" "${_jw_a8}" "${_jw_a9}" ${o})
  else()
    message(FATAL_ERROR "run-cases.cmake: more than 10 arguments")
  endif()
  set(_jw_rc "${rc}" PARENT_SCOPE)
  set(_jw_out "${out}" PARENT_SCOPE)
  set(_jw_err "${err}" PARENT_SCOPE)
endfunction()

function(_jw_short out text)
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE "\n" " / " text "${text}")
  string(LENGTH "${text}" n)
  if(n GREATER 160)
    string(SUBSTRING "${text}" 0 160 text)
    string(APPEND text "...")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Sets <out> to "" when <text> matches the expectation (literal or ~regex), else to a reason.
function(_jw_match out text expect)
  if(expect MATCHES "^~(.*)$")
    set(re "${CMAKE_MATCH_1}")
    if(text MATCHES "${re}")
      set(${out} "" PARENT_SCOPE)
    else()
      set(${out} "does not match /${re}/" PARENT_SCOPE)
    endif()
  elseif(text STREQUAL expect)
    set(${out} "" PARENT_SCOPE)
  else()
    set(${out} "expected '${expect}'" PARENT_SCOPE)
  endif()
endfunction()

# First difference between two JSON values (expected, actual) as "<pointer>: <reason>".
function(_jw_json_diff out exp act ptr)
  string(JSON te TYPE "${exp}")
  string(JSON ta TYPE "${act}")
  if(NOT te STREQUAL ta)
    _jw_short(se "${exp}")
    _jw_short(sa "${act}")
    set(${out} "${ptr}: expected ${te} ${se}, got ${ta} ${sa}" PARENT_SCOPE)
    return()
  endif()
  if(te STREQUAL "OBJECT")
    foreach(side IN ITEMS exp act)
      if(side STREQUAL "exp")
        set(a "${exp}")
        set(b "${act}")
        set(why "missing")
      else()
        set(a "${act}")
        set(b "${exp}")
        set(why "unexpected member")
      endif()
      string(JSON n LENGTH "${a}")
      if(n GREATER 0)
        math(EXPR last "${n} - 1")
        foreach(i RANGE ${last})
          string(JSON k MEMBER "${a}" ${i})
          string(JSON t ERROR_VARIABLE e TYPE "${b}" "${k}")
          if(NOT e STREQUAL "NOTFOUND")
            set(${out} "${ptr}/${k}: ${why}" PARENT_SCOPE)
            return()
          endif()
        endforeach()
      endif()
    endforeach()
    string(JSON n LENGTH "${exp}")
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${exp}" ${i})
      _jw_json_child_diff(d "${exp}" "${act}" "${k}" "${ptr}/${k}")
      if(NOT d STREQUAL "")
        set(${out} "${d}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  elseif(te STREQUAL "ARRAY")
    string(JSON ne LENGTH "${exp}")
    string(JSON na LENGTH "${act}")
    set(n ${ne})
    if(na LESS ne)
      set(n ${na})
    endif()
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      foreach(i RANGE ${last})
        _jw_json_child_diff(d "${exp}" "${act}" "${i}" "${ptr}/${i}")
        if(NOT d STREQUAL "")
          set(${out} "${d}" PARENT_SCOPE)
          return()
        endif()
      endforeach()
    endif()
    if(NOT ne EQUAL na)
      set(${out} "${ptr}: expected ${ne} items, got ${na}" PARENT_SCOPE)
      return()
    endif()
  endif()
  set(${out} "${ptr}: values differ" PARENT_SCOPE)
endfunction()

function(_jw_json_child_diff out exp act key ptr)
  string(JSON te TYPE "${exp}" "${key}")
  string(JSON ta TYPE "${act}" "${key}")
  string(JSON ve GET "${exp}" "${key}")
  string(JSON va GET "${act}" "${key}")
  if(te STREQUAL ta AND (te STREQUAL "OBJECT" OR te STREQUAL "ARRAY"))
    string(JSON eq EQUAL "${ve}" "${va}")
    if(eq)
      set(${out} "" PARENT_SCOPE)
    else()
      _jw_json_diff(d "${ve}" "${va}" "${ptr}")
      set(${out} "${d}" PARENT_SCOPE)
    endif()
  elseif(te STREQUAL ta AND ve STREQUAL va)
    set(${out} "" PARENT_SCOPE)
  else()
    _jw_short(se "${ve}")
    _jw_short(sa "${va}")
    set(${out} "${ptr}: expected ${te} '${se}', got ${ta} '${sa}'" PARENT_SCOPE)
  endif()
endfunction()

# ---- redact helpers (S1-PR2)

set(_jw_kinds stream_key bearer_token rtmp_auth oauth_token ws_password url_credential forced)
string(HEX "SECRETvalue" _jw_secret_hex)
string(HEX "PLAINvalue" _jw_plain_hex)
string(HEX "true" _jw_true_hex)
set(_jw_marker_limit 4194304) # marker scans read the file as hex; generated big inputs hold no marker

# Number of occurrences of <needle> (hex) in <hex> that start on a byte boundary. <hex> is searched in
# blocks of 64 Ki hex digits, so that many occurrences in a big file (a failing case) take linear time.
function(_jw_hex_count out hex needle)
  set(n 0)
  set(block 65536)
  string(LENGTH "${hex}" total)
  string(LENGTH "${needle}" l)
  math(EXPR w "${block} + ${l} - 2") # a match that starts in the block ends in this window
  set(k 0)
  while(k LESS total)
    string(SUBSTRING "${hex}" ${k} ${w} rest)
    set(off 0)
    while(1)
      string(FIND "${rest}" "${needle}" p)
      if(p EQUAL -1)
        break()
      endif()
      math(EXPR at "${off} + ${p}")
      if(NOT at LESS block)
        break() # counted with the next block
      endif()
      math(EXPR a "${at} % 2")
      if(a EQUAL 0)
        math(EXPR n "${n} + 1")
        math(EXPR step "${p} + ${l}")
      else()
        math(EXPR step "${p} + 1")
      endif()
      math(EXPR off "${off} + ${step}")
      string(SUBSTRING "${rest}" ${step} -1 rest)
    endwhile()
    math(EXPR k "${k} + ${block}")
  endwhile()
  set(${out} ${n} PARENT_SCOPE)
endfunction()

# Byte offset of the first difference between two hex strings, as text (binary search on prefixes).
function(_jw_hex_first_diff out a b)
  string(LENGTH "${a}" la)
  string(LENGTH "${b}" lb)
  math(EXPR la "${la} / 2")
  math(EXPR lb "${lb} / 2")
  set(lo 0)
  set(hi ${la})
  if(lb LESS la)
    set(hi ${lb})
  endif()
  while(lo LESS hi)
    math(EXPR mid "(${lo} + ${hi} + 1) / 2")
    math(EXPR n "${mid} * 2")
    string(SUBSTRING "${a}" 0 ${n} x)
    string(SUBSTRING "${b}" 0 ${n} y)
    if(x STREQUAL y)
      set(lo ${mid})
    else()
      math(EXPR hi "${mid} - 1")
    endif()
  endwhile()
  set(${out} "first difference at byte ${lo} (expected ${la} bytes, got ${lb})" PARENT_SCOPE)
endfunction()

# Marker counts of a file too big for the hex scan: file(STRINGS) streams the file and keeps the
# printable runs that hold a marker. Markers are printable ASCII, so no marker is cut; a CR inside
# one would be dropped, which only adds a false alarm.
function(_jw_strings_markers secretvar plainvar file)
  file(STRINGS "${file}" lines REGEX "SECRETvalue|PLAINvalue" NO_HEX_CONVERSION)
  string(REGEX MATCHALL "SECRETvalue" m "${lines}")
  list(LENGTH m ns)
  string(REGEX MATCHALL "PLAINvalue" m "${lines}")
  list(LENGTH m np)
  set(${secretvar} ${ns} PARENT_SCOPE)
  set(${plainvar} ${np} PARENT_SCOPE)
endfunction()

# Sets <out> to "" if <len> bytes of file <a> from offset <ao> equal those of file <b> from <bo>, else to
# a reason. Reads 1 MiB of each file at a time.
function(_jw_cmp_bytes out a ao b bo len)
  set(chunk 1048576)
  while(len GREATER 0)
    set(c ${chunk})
    if(len LESS chunk)
      set(c ${len})
    endif()
    file(READ "${a}" x OFFSET ${ao} LIMIT ${c} HEX)
    file(READ "${b}" y OFFSET ${bo} LIMIT ${c} HEX)
    if(NOT x STREQUAL y)
      _jw_hex_first_diff(d "${x}" "${y}")
      string(REGEX MATCH "at byte ([0-9]+)" d "${d}")
      math(EXPR ao "${ao} + ${CMAKE_MATCH_1}")
      math(EXPR bo "${bo} + ${CMAKE_MATCH_1}")
      set(${out} "INFILE byte ${ao} differs from OUTFILE byte ${bo}" PARENT_SCOPE)
      return()
    endif()
    math(EXPR ao "${ao} + ${c}")
    math(EXPR bo "${bo} + ${c}")
    math(EXPR len "${len} - ${c}")
  endwhile()
  set(${out} "" PARENT_SCOPE)
endfunction()

# The OUTFILE checks of _jw_stored_checks for an INFILE or OUTFILE over the marker limit, without
# reading either file whole: the size, the bytes between the <ranges> ("start,end,kind" items, already
# checked) and each replacement at its place in OUTFILE. Sets <whyvar> and, for a random placeholder,
# <phvar> as _jw_stored_checks does.
function(_jw_big_out_checks whyvar phvar in outf ranges ph insize outsize)
  set(phlen 32)
  if(NOT ph STREQUAL "")
    string(LENGTH "${ph}" phlen)
    string(HEX "${ph}" phhex)
  endif()
  set(want ${insize})
  foreach(rg IN LISTS ranges)
    string(REPLACE "," ";" rg "${rg}")
    list(GET rg 0 s)
    list(GET rg 1 z)
    list(GET rg 2 k)
    set(r 0)
    if(k STREQUAL "forced")
      set(r 4)
    elseif(k STREQUAL "ws_password")
      set(r ${phlen})
    endif()
    math(EXPR want "${want} - (${z} - ${s}) + ${r}")
  endforeach()
  if(NOT outsize EQUAL want)
    set(${whyvar} "OUTFILE has ${outsize} bytes, INFILE with the reported ranges replaced ${want}" PARENT_SCOPE)
    set(${phvar} "" PARENT_SCOPE)
    return()
  endif()
  set(why "")
  set(got "")
  set(ip 0)
  set(op 0)
  foreach(rg IN LISTS ranges)
    string(REPLACE "," ";" rg "${rg}")
    list(GET rg 0 s)
    list(GET rg 1 z)
    list(GET rg 2 k)
    math(EXPR l "${s} - ${ip}")
    _jw_cmp_bytes(d "${in}" ${ip} "${outf}" ${op} ${l})
    if(NOT d STREQUAL "")
      list(APPEND why "OUTFILE is not INFILE with the reported ranges replaced: ${d}")
      break()
    endif()
    math(EXPR op "${op} + ${l}")
    if(k STREQUAL "forced")
      file(READ "${outf}" x OFFSET ${op} LIMIT 4 HEX)
      if(NOT x STREQUAL "${_jw_true_hex}")
        list(APPEND why "OUTFILE: the forced redaction at INFILE byte ${s} is not replaced by true")
      endif()
      math(EXPR op "${op} + 4")
    elseif(k STREQUAL "ws_password")
      file(READ "${outf}" x OFFSET ${op} LIMIT ${phlen} HEX)
      if(NOT ph STREQUAL "")
        if(NOT x STREQUAL "${phhex}")
          list(APPEND why "OUTFILE: the ws_password at INFILE byte ${s} is not replaced by the placeholder")
        endif()
      else()
        string(LENGTH "${x}" l)
        if(NOT l EQUAL 64 OR NOT x MATCHES "^((3[0-9])|(4[1-9a-f])|(5[0-9a])|(6[1-9a-f])|(7[0-9a]))+$")
          list(APPEND why "OUTFILE: the random ws_password placeholder at byte ${s} is not 32 characters of A-Za-z0-9")
        endif()
        set(got "${x}")
      endif()
      math(EXPR op "${op} + ${phlen}")
    endif()
    set(ip ${z})
  endforeach()
  if(why STREQUAL "")
    math(EXPR l "${insize} - ${ip}")
    _jw_cmp_bytes(d "${in}" ${ip} "${outf}" ${op} ${l})
    if(NOT d STREQUAL "")
      list(APPEND why "OUTFILE is not INFILE with the reported ranges replaced: ${d}")
    endif()
  endif()
  set(${whyvar} "${why}" PARENT_SCOPE)
  set(${phvar} "${got}" PARENT_SCOPE)
endfunction()

# Checks a stored outcome: the redactions of REPORT <rep> (shape, 0 <= start <= end <= size of
# INFILE, sorted by start and not overlapping), OUTFILE = INFILE with each range replaced (by ""
# for most kinds, "true" for forced, the placeholder for ws_password), no SECRETvalue marker left
# and every PLAINvalue marker kept (over 4 MiB counted by _jw_strings_markers). <ph> is the
# --ws-placeholder value, or "" for a random one: it is then read from OUTFILE, must be 32
# characters of [A-Za-z0-9] and is returned in <phvar> as hex.
function(_jw_stored_checks whyvar phvar nvar in outf rep ph)
  set(why "")
  set(got "")
  set(${phvar} "" PARENT_SCOPE)
  set(${nvar} 0 PARENT_SCOPE)
  file(SIZE "${in}" insize)
  file(SIZE "${outf}" outsize)
  string(JSON t ERROR_VARIABLE e TYPE "${rep}" redactions)
  if(NOT e STREQUAL "NOTFOUND" OR NOT t STREQUAL "ARRAY")
    set(${whyvar} "REPORT: redactions is not an array" PARENT_SCOPE)
    return()
  endif()
  string(JSON n LENGTH "${rep}" redactions)
  set(${nvar} ${n} PARENT_SCOPE)
  set(prev 0)
  set(ranges "")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      set(r "REPORT redactions/${i}")
      string(JSON t ERROR_VARIABLE e TYPE "${rep}" redactions ${i})
      if(NOT t STREQUAL "OBJECT")
        list(APPEND why "${r} is not an object")
        break()
      endif()
      string(JSON tp ERROR_VARIABLE e TYPE "${rep}" redactions ${i} pointer)
      string(JSON k ERROR_VARIABLE e GET "${rep}" redactions ${i} kind)
      string(JSON ts ERROR_VARIABLE e TYPE "${rep}" redactions ${i} start)
      string(JSON te ERROR_VARIABLE e TYPE "${rep}" redactions ${i} end)
      string(JSON s ERROR_VARIABLE e GET "${rep}" redactions ${i} start)
      string(JSON z ERROR_VARIABLE e GET "${rep}" redactions ${i} end)
      if(NOT tp STREQUAL "STRING")
        list(APPEND why "${r}/pointer is not a string")
      endif()
      if(NOT k IN_LIST _jw_kinds)
        list(APPEND why "${r}/kind '${k}' is unknown")
      endif()
      if(NOT ts STREQUAL "NUMBER" OR NOT te STREQUAL "NUMBER" OR NOT s MATCHES "^[0-9]+$"
         OR NOT z MATCHES "^[0-9]+$")
        list(APPEND why "${r}: start and end must be integers >= 0")
        break()
      endif()
      if(k STREQUAL "forced")
        string(JSON tw ERROR_VARIABLE e TYPE "${rep}" redactions ${i} was)
        string(JSON w ERROR_VARIABLE e GET "${rep}" redactions ${i} was)
        if(NOT tw STREQUAL "BOOLEAN" OR NOT w STREQUAL "OFF")
          list(APPEND why "${r}: a forced redaction needs \"was\": false")
        endif()
      endif()
      if(s LESS prev)
        list(APPEND why "${r}: start ${s} is before the end ${prev} of the previous range (unsorted or overlapping)")
      endif()
      if(z LESS s OR z GREATER insize)
        list(APPEND why "${r}: needs start ${s} <= end ${z} <= ${insize} (INFILE size)")
      endif()
      set(prev ${z})
      list(APPEND ranges "${s},${z},${k}")
    endforeach()
  endif()
  if(NOT why STREQUAL "")
    set(${whyvar} "${why}" PARENT_SCOPE)
    return()
  endif()
  set(small FALSE)
  if(NOT insize GREATER _jw_marker_limit AND NOT outsize GREATER _jw_marker_limit)
    set(small TRUE)
  endif()
  if(n EQUAL 0 AND NOT small)
    file(SHA256 "${in}" hi)
    file(SHA256 "${outf}" ho)
    if(NOT outsize EQUAL insize OR NOT hi STREQUAL ho)
      list(APPEND why "OUTFILE differs from INFILE (${outsize} bytes, INFILE ${insize}) without a redaction")
    endif()
    _jw_strings_markers(c co "${outf}")
    if(NOT c EQUAL 0)
      list(APPEND why "OUTFILE still holds ${c} SECRETvalue marker(s)")
    endif()
    set(${whyvar} "${why}" PARENT_SCOPE)
    return()
  endif()
  if(NOT small)
    _jw_big_out_checks(w got "${in}" "${outf}" "${ranges}" "${ph}" ${insize} ${outsize})
    list(APPEND why ${w})
    _jw_strings_markers(c co "${outf}")
    _jw_strings_markers(x ci "${in}")
    if(NOT c EQUAL 0)
      list(APPEND why "OUTFILE still holds ${c} SECRETvalue marker(s)")
    endif()
    if(NOT ci EQUAL co)
      list(APPEND why "OUTFILE holds ${co} PLAINvalue marker(s), INFILE ${ci}")
    endif()
    set(${whyvar} "${why}" PARENT_SCOPE)
    set(${phvar} "${got}" PARENT_SCOPE)
    return()
  endif()
  file(READ "${in}" ih HEX)
  file(READ "${outf}" oh HEX)
  set(exp "")
  set(prev 0)
  foreach(rg IN LISTS ranges)
    string(REPLACE "," ";" rg "${rg}")
    list(GET rg 0 s)
    list(GET rg 1 z)
    list(GET rg 2 k)
    math(EXPR p "${prev} * 2")
    math(EXPR l "(${s} - ${prev}) * 2")
    string(SUBSTRING "${ih}" ${p} ${l} seg)
    string(APPEND exp "${seg}")
    if(k STREQUAL "forced")
      string(APPEND exp "${_jw_true_hex}")
    elseif(k STREQUAL "ws_password")
      if(NOT ph STREQUAL "")
        string(HEX "${ph}" x)
        string(APPEND exp "${x}")
      else()
        string(LENGTH "${exp}" p)
        string(LENGTH "${oh}" l)
        set(x "")
        if(NOT p GREATER l)
          string(SUBSTRING "${oh}" ${p} 64 x)
        endif()
        if(NOT x MATCHES "^((3[0-9])|(4[1-9a-f])|(5[0-9a])|(6[1-9a-f])|(7[0-9a]))+$")
          list(APPEND why "OUTFILE: the random ws_password placeholder at byte ${s} is not 32 characters of A-Za-z0-9")
        else()
          string(LENGTH "${x}" l)
          if(NOT l EQUAL 64)
            list(APPEND why "OUTFILE: the random ws_password placeholder at byte ${s} is too short")
          endif()
        endif()
        string(APPEND exp "${x}")
        set(got "${x}")
      endif()
    endif()
    set(prev ${z})
  endforeach()
  math(EXPR p "${prev} * 2")
  string(SUBSTRING "${ih}" ${p} -1 seg)
  string(APPEND exp "${seg}")
  if(NOT exp STREQUAL oh)
    _jw_hex_first_diff(d "${exp}" "${oh}")
    list(APPEND why "OUTFILE is not INFILE with the reported ranges replaced: ${d}")
  endif()
  if(small)
    _jw_hex_count(c "${oh}" "${_jw_secret_hex}")
    if(NOT c EQUAL 0)
      list(APPEND why "OUTFILE still holds ${c} SECRETvalue marker(s)")
    endif()
    _jw_hex_count(ci "${ih}" "${_jw_plain_hex}")
    _jw_hex_count(co "${oh}" "${_jw_plain_hex}")
    if(NOT ci EQUAL co)
      list(APPEND why "OUTFILE holds ${co} PLAINvalue marker(s), INFILE ${ci}")
    endif()
  else()
    _jw_strings_markers(c co "${outf}")
    _jw_strings_markers(x ci "${in}")
    if(NOT c EQUAL 0)
      list(APPEND why "OUTFILE still holds ${c} SECRETvalue marker(s)")
    endif()
    if(NOT ci EQUAL co)
      list(APPEND why "OUTFILE holds ${co} PLAINvalue marker(s), INFILE ${ci}")
    endif()
  endif()
  set(${whyvar} "${why}" PARENT_SCOPE)
  set(${phvar} "${got}" PARENT_SCOPE)
endfunction()

# File checks of a redact case, after its exit code and stdout were checked. Reads the case's
# decoded arguments (_jw_a0 ..) and results (_jw_rc, _jw_stdout) from the caller. Returns the
# problems in _jw_rwhy and a summary in _jw_rdetail.
function(_jw_redact_checks idx)
  set(why "")
  set(detail "")
  set(own_out FALSE)
  set(own_rep FALSE)
  if(_jw_argc GREATER 3 AND _jw_a3 STREQUAL JW_VAR_OUT)
    set(own_out TRUE)
  endif()
  if(_jw_argc GREATER 4 AND _jw_a4 STREQUAL JW_VAR_REPORT)
    set(own_rep TRUE)
  endif()
  set(ph "")
  if(_jw_argc EQUAL 7 AND _jw_a5 STREQUAL "--ws-placeholder")
    set(ph "${_jw_a6}")
  endif()
  set(in "")
  if(_jw_argc GREATER 2)
    get_filename_component(in "${_jw_a2}" ABSOLUTE BASE_DIR "${CASES_DIR}")
  endif()
  set(failed FALSE)
  if(NOT "${_jw_rc}" STREQUAL "0" OR NOT _jw_stdout STREQUAL "OK")
    set(failed TRUE)
  endif()
  # An unexpected OK on a case that expects an error has already failed on its exit code and stdout.
  if(failed OR NOT own_rep OR "${_jw_case${idx}_report}" STREQUAL "")
    if(failed AND own_out AND EXISTS "${JW_VAR_OUT}")
      list(APPEND why "OUTFILE was written although jw-check did not succeed")
    endif()
    set(_jw_rwhy "${why}" PARENT_SCOPE)
    set(_jw_rdetail "" PARENT_SCOPE)
    return()
  endif()
  if(NOT EXISTS "${JW_VAR_REPORT}" OR IS_DIRECTORY "${JW_VAR_REPORT}")
    set(_jw_rwhy "no REPORT written" PARENT_SCOPE)
    return()
  endif()
  if(NOT EXISTS "${in}" OR IS_DIRECTORY "${in}")
    set(_jw_rwhy "jw-check printed OK for an INFILE that is not a file" PARENT_SCOPE)
    return()
  endif()
  file(READ "${JW_VAR_REPORT}" rep)
  string(JSON t ERROR_VARIABLE e TYPE "${rep}")
  if(NOT e STREQUAL "NOTFOUND" OR NOT t STREQUAL "OBJECT")
    _jw_short(s "${rep}")
    set(_jw_rwhy "REPORT is not one JSON object: '${s}'" PARENT_SCOPE)
    return()
  endif()
  set(want "${_jw_case${idx}_report}")
  set(match "")
  if(NOT want STREQUAL "*")
    foreach(f IN LISTS want)
      file(READ "${f}" w)
      string(JSON eq EQUAL "${w}" "${rep}")
      if(eq)
        set(match "${f}")
        break()
      endif()
    endforeach()
    if(match STREQUAL "")
      list(GET want 0 f)
      _jw_case_name(fs "${f}")
      file(READ "${f}" w)
      string(LENGTH "${w}${rep}" l)
      if(l GREATER 65536)
        set(d "(${l} bytes, not compared member by member)")
      else()
        _jw_json_diff(d "${w}" "${rep}" "")
      endif()
      _jw_short(s "${rep}")
      list(APPEND why "REPORT differs from ${fs} at ${d}" "REPORT '${s}'")
    else()
      _jw_case_name(fs "${match}")
      set(detail "REPORT = ${fs}")
    endif()
  else()
    set(detail "REPORT not compared")
  endif()
  string(JSON outcome ERROR_VARIABLE e GET "${rep}" outcome)
  # The range checks parse REPORT once per range: a REPORT with more than 256 ranges is instead
  # checked by its equality with an expected REPORT plus an expected OUTFILE (out=), both made
  # together by run-cases.cmake.
  set(many FALSE)
  if(outcome STREQUAL "stored")
    string(JSON n ERROR_VARIABLE e LENGTH "${rep}" redactions)
    if(e STREQUAL "NOTFOUND" AND n GREATER 256)
      set(many TRUE)
    endif()
  endif()
  set(outx "${_jw_case${idx}_outx}")
  if(outcome STREQUAL "stored")
    if(NOT own_out)
      list(APPEND why "a stored case must write this case's OUTFILE")
    elseif(NOT EXISTS "${JW_VAR_OUT}" OR IS_DIRECTORY "${JW_VAR_OUT}")
      list(APPEND why "REPORT says stored but no OUTFILE was written")
    elseif(many AND (match STREQUAL "" OR outx STREQUAL ""))
      if(outx STREQUAL "")
        list(APPEND why "REPORT has ${n} ranges: the case needs an expected REPORT and out=FILE")
      endif()
    else()
      if(many)
        set(w "")
        file(SIZE "${in}" insize)
        if(insize GREATER _jw_marker_limit)
          _jw_strings_markers(x ci "${in}")
          _jw_strings_markers(c co "${JW_VAR_OUT}")
        else()
          file(READ "${in}" ih HEX)
          file(READ "${JW_VAR_OUT}" oh HEX)
          _jw_hex_count(ci "${ih}" "${_jw_plain_hex}")
          _jw_hex_count(c "${oh}" "${_jw_secret_hex}")
          _jw_hex_count(co "${oh}" "${_jw_plain_hex}")
        endif()
        if(NOT c EQUAL 0)
          list(APPEND w "OUTFILE still holds ${c} SECRETvalue marker(s)")
        endif()
        if(NOT ci EQUAL co)
          list(APPEND w "OUTFILE holds ${co} PLAINvalue marker(s), INFILE ${ci}")
        endif()
        set(got "")
      else()
        _jw_stored_checks(w got n "${in}" "${JW_VAR_OUT}" "${rep}" "${ph}")
      endif()
      list(APPEND why ${w})
      string(APPEND detail ", OUTFILE = INFILE with ${n} range(s) edited")
      if(NOT outx STREQUAL "")
        _jw_case_name(fs "${outx}")
        file(SHA256 "${outx}" hx)
        file(SHA256 "${JW_VAR_OUT}" ho)
        if(NOT hx STREQUAL ho)
          file(READ "${outx}" xh HEX)
          file(READ "${JW_VAR_OUT}" oh HEX)
          _jw_hex_first_diff(d "${xh}" "${oh}")
          list(APPEND why "OUTFILE differs from ${fs}: ${d}")
        else()
          string(APPEND detail " = ${fs}")
        endif()
      endif()
      # A random placeholder: a second run gives the same REPORT and another placeholder.
      if(why STREQUAL "" AND NOT got STREQUAL "")
        file(REMOVE "${JW_VAR_OUT}" "${JW_VAR_REPORT}")
        _jw_exec(${_jw_argc})
        string(REGEX REPLACE "[\r\n]+$" "" o2 "${_jw_out}")
        if(NOT "${_jw_rc}" STREQUAL "0" OR NOT o2 STREQUAL "OK")
          list(APPEND why "second run (random placeholder): exit ${_jw_rc}, stdout '${o2}'")
        elseif(NOT EXISTS "${JW_VAR_REPORT}" OR NOT EXISTS "${JW_VAR_OUT}")
          list(APPEND why "second run (random placeholder): no REPORT or no OUTFILE")
        else()
          file(READ "${JW_VAR_REPORT}" rep2)
          string(JSON eq ERROR_VARIABLE e EQUAL "${rep}" "${rep2}")
          if(NOT e STREQUAL "NOTFOUND" OR NOT eq)
            list(APPEND why "second run (random placeholder): another REPORT")
          else()
            _jw_stored_checks(w got2 n "${in}" "${JW_VAR_OUT}" "${rep2}" "")
            list(APPEND why ${w})
            if(got2 STREQUAL got)
              list(APPEND why "second run: the random ws_password placeholder repeated")
            else()
              string(APPEND detail ", random placeholder differs between two runs")
            endif()
          endif()
        endif()
      endif()
    endif()
  elseif(outcome STREQUAL "omitted")
    if(own_out AND EXISTS "${JW_VAR_OUT}")
      list(APPEND why "REPORT says omitted but OUTFILE was written")
    else()
      string(APPEND detail ", no OUTFILE")
    endif()
  else()
    list(APPEND why "REPORT outcome '${outcome}' is neither stored nor omitted")
  endif()
  set(_jw_rwhy "${why}" PARENT_SCOPE)
  set(_jw_rdetail "${detail}" PARENT_SCOPE)
endfunction()

# ---- plan helpers (S1-PR3)

# Decodes a path of a tree file: %XX is the byte 0xXX, {N*C} the character C repeated N times.
function(_jw_tree_decode out text where)
  set(res "")
  set(rest "${text}")
  while(NOT rest STREQUAL "")
    string(FIND "${rest}" "%" p)
    string(FIND "${rest}" "{" q)
    if(p EQUAL -1 AND q EQUAL -1)
      string(APPEND res "${rest}")
      break()
    endif()
    if(q EQUAL -1 OR (NOT p EQUAL -1 AND p LESS q))
      string(SUBSTRING "${rest}" 0 ${p} pre)
      string(APPEND res "${pre}")
      math(EXPR a "${p} + 1")
      string(SUBSTRING "${rest}" ${a} 2 hex)
      if(NOT hex MATCHES "^[0-9A-Fa-f][0-9A-Fa-f]$")
        message(FATAL_ERROR "${where}: bad escape in '${text}'")
      endif()
      math(EXPR code "0x${hex}")
      if(code EQUAL 0)
        message(FATAL_ERROR "${where}: %00 cannot be part of a name")
      endif()
      string(ASCII ${code} ch)
      string(APPEND res "${ch}")
      math(EXPR a "${p} + 3")
      string(SUBSTRING "${rest}" ${a} -1 rest)
    else()
      string(SUBSTRING "${rest}" 0 ${q} pre)
      string(APPEND res "${pre}")
      string(SUBSTRING "${rest}" ${q} -1 rest)
      if(NOT rest MATCHES "^[{]([1-9][0-9]*)[*]([^{}%])[}]")
        message(FATAL_ERROR "${where}: bad repetition in '${text}'")
      endif()
      string(REPEAT "${CMAKE_MATCH_2}" ${CMAKE_MATCH_1} x)
      string(APPEND res "${x}")
      string(LENGTH "${CMAKE_MATCH_0}" l)
      string(SUBSTRING "${rest}" ${l} -1 rest)
    endif()
  endwhile()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Whether this filesystem can hold what a tree needs (probed once in WORK_DIR/plan-probe):
#   symlinks        file(CREATE_LINK ... SYMBOLIC) works
#   case-sensitive  "a" and "A" are two names
#   non-utf8-names  a name with a byte that is not UTF-8 is kept byte for byte
#   reserved-names  names with ? : < > | * " TAB, a trailing dot or space and a device name are kept
#   long-names      a 255-byte name is kept
function(_jw_plan_probe out feature)
  get_property(have GLOBAL PROPERTY JW_PROBE_${feature} SET)
  if(have)
    get_property(ok GLOBAL PROPERTY JW_PROBE_${feature})
    set(${out} ${ok} PARENT_SCOPE)
    return()
  endif()
  set(d "${WORK_DIR}/plan-probe/${feature}")
  file(REMOVE_RECURSE "${d}")
  file(MAKE_DIRECTORY "${d}")
  set(ok FALSE)
  set(names "")
  if(feature STREQUAL "symlinks")
    file(WRITE "${d}/target" "x")
    file(CREATE_LINK target "${d}/link" RESULT r SYMBOLIC)
    if(r STREQUAL "0" AND IS_SYMLINK "${d}/link")
      set(ok TRUE)
    endif()
  elseif(feature STREQUAL "case-sensitive")
    file(WRITE "${d}/a" "x")
    if(NOT EXISTS "${d}/A")
      set(ok TRUE)
    endif()
  elseif(feature STREQUAL "non-utf8-names")
    string(ASCII 255 x)
    set(names "a${x}b")
  elseif(feature STREQUAL "reserved-names")
    string(ASCII 9 x)
    set(names "What?" "a:b" "t${x}b" "e." "s " "CON.json" "x|y" "q\"" "a<b>" "s*")
  elseif(feature STREQUAL "long-names")
    string(REPEAT "a" 255 x)
    set(names "${x}")
  else()
    message(FATAL_ERROR "run-cases.cmake: unknown tree feature '${feature}'")
  endif()
  if(NOT names STREQUAL "")
    set(ok TRUE)
    foreach(n IN LISTS names)
      file(WRITE "${d}/new" "x")
      file(RENAME "${d}/new" "${d}/${n}" RESULT r)
      if(NOT r STREQUAL "0" OR NOT EXISTS "${d}/${n}")
        set(ok FALSE)
      endif()
    endforeach()
    file(GLOB got RELATIVE "${d}" "${d}/*")
    foreach(n IN LISTS names)
      if(NOT n IN_LIST got)
        set(ok FALSE)
      endif()
    endforeach()
  endif()
  set_property(GLOBAL PROPERTY JW_PROBE_${feature} ${ok})
  set(${out} ${ok} PARENT_SCOPE)
endfunction()

# Creates the parent directory of <rel> (a decoded path in tree <root>); names in a tree hold no backslash
# except in their last component, which file(RENAME) and file(COPY_FILE) keep as it is.
function(_jw_tree_parent root rel)
  string(FIND "${rel}" "/" p REVERSE)
  if(p GREATER 0)
    string(SUBSTRING "${rel}" 0 ${p} dir)
    file(MAKE_DIRECTORY "${root}/${dir}")
  endif()
endfunction()

# A file of <size> bytes "x" at <rel>: written under a plain name, then renamed, so that every byte of
# the name stays as decoded (file(WRITE) would turn a backslash into a directory separator).
function(_jw_tree_file root rel size where)
  _jw_tree_parent("${root}" "${rel}")
  set(content "")
  if(size GREATER 0)
    string(REPEAT "x" ${size} content)
  endif()
  file(WRITE "${root}/.jw-new" "${content}")
  file(RENAME "${root}/.jw-new" "${root}/${rel}" RESULT r)
  if(NOT r STREQUAL "0")
    message(FATAL_ERROR "${where}: cannot create '${rel}': ${r}")
  endif()
endfunction()

# Builds tree <name> from fixtures/plan/trees/<name>.tree into WORK_DIR/plan/<name>, once per run (it is
# removed and rebuilt from scratch first). Sets <skipvar> to a reason when this filesystem lacks a feature
# the tree needs, else to "". The format is documented at the top of cases.txt.
function(_jw_plan_tree skipvar name)
  get_property(have GLOBAL PROPERTY JW_TREE_${name} SET)
  if(have)
    get_property(s GLOBAL PROPERTY JW_TREE_${name})
    set(${skipvar} "${s}" PARENT_SCOPE)
    return()
  endif()
  set(spec "${CASES_DIR}/fixtures/plan/trees/${name}.tree")
  file(READ "${spec}" text)
  string(REPLACE "\r" "" text "${text}")
  foreach(bad IN ITEMS ";" "[" "]" "\\")
    string(FIND "${text}" "${bad}" p)
    if(NOT p EQUAL -1)
      message(FATAL_ERROR "fixtures/plan/trees/${name}.tree: '${bad}' is not allowed (byte offset ${p}), use %XX")
    endif()
  endforeach()
  string(REPLACE "\n" ";" lines "${text}")
  # needs
  set(skip "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^needs (.+)$")
      string(REPLACE " " ";" feats "${CMAKE_MATCH_1}")
      foreach(f IN LISTS feats)
        _jw_plan_probe(ok "${f}")
        if(NOT ok)
          set(skip "needs ${f}, which this filesystem does not have")
        endif()
      endforeach()
    endif()
  endforeach()
  if(NOT skip STREQUAL "")
    set_property(GLOBAL PROPERTY JW_TREE_${name} "${skip}")
    set(${skipvar} "${skip}" PARENT_SCOPE)
    return()
  endif()
  set(root "${WORK_DIR}/plan/${name}")
  file(REMOVE_RECURSE "${root}")
  file(MAKE_DIRECTORY "${root}")
  set(n 0)
  foreach(line IN LISTS lines)
    math(EXPR n "${n} + 1")
    set(where "fixtures/plan/trees/${name}.tree:${n}")
    if(line STREQUAL "" OR line MATCHES "^#" OR line MATCHES "^needs ")
      continue()
    endif()
    string(REPLACE " " ";" f "${line}")
    list(LENGTH f nf)
    list(GET f 0 verb)
    if(verb STREQUAL "dir" AND nf EQUAL 2)
      list(GET f 1 p)
      _jw_tree_decode(p "${p}" "${where}")
      file(MAKE_DIRECTORY "${root}/${p}")
    elseif(verb STREQUAL "file" AND nf EQUAL 3)
      list(GET f 1 p)
      list(GET f 2 size)
      if(NOT size MATCHES "^[0-9]+$")
        message(FATAL_ERROR "${where}: bad size '${size}'")
      endif()
      _jw_tree_decode(p "${p}" "${where}")
      _jw_tree_file("${root}" "${p}" ${size} "${where}")
    elseif(verb STREQUAL "copy" AND nf EQUAL 3)
      list(GET f 1 p)
      list(GET f 2 src)
      _jw_tree_decode(p "${p}" "${where}")
      if(NOT EXISTS "${CASES_DIR}/${src}" OR IS_DIRECTORY "${CASES_DIR}/${src}")
        message(FATAL_ERROR "${where}: '${src}' is not a file")
      endif()
      _jw_tree_parent("${root}" "${p}")
      file(COPY_FILE "${CASES_DIR}/${src}" "${root}/${p}" RESULT r)
      if(NOT r STREQUAL "0")
        message(FATAL_ERROR "${where}: cannot copy '${src}': ${r}")
      endif()
    elseif(verb STREQUAL "link" AND nf EQUAL 3)
      list(GET f 1 p)
      list(GET f 2 target)
      _jw_tree_decode(p "${p}" "${where}")
      _jw_tree_decode(target "${target}" "${where}")
      _jw_tree_parent("${root}" "${p}")
      file(CREATE_LINK "${target}" "${root}/${p}" RESULT r SYMBOLIC)
      if(NOT r STREQUAL "0")
        message(FATAL_ERROR "${where}: cannot create the link '${p}': ${r}")
      endif()
    elseif(verb STREQUAL "many" AND nf EQUAL 4)
      # COUNT files DIR/PREFIX0001.txt ..., file k has k bytes
      list(GET f 1 p)
      list(GET f 2 count)
      list(GET f 3 prefix)
      _jw_tree_decode(p "${p}" "${where}")
      file(MAKE_DIRECTORY "${root}/${p}")
      set(content "")
      foreach(k RANGE 1 ${count})
        math(EXPR z "10000 + ${k}")
        string(SUBSTRING "${z}" 1 4 z)
        string(APPEND content "x")
        file(WRITE "${root}/${p}/${prefix}${z}.txt" "${content}")
      endforeach()
    elseif(verb STREQUAL "profiles" AND nf EQUAL 4)
      # COUNT folders DIR/p000 ..., each with basic.ini and FILES files u001.txt ... of one byte
      list(GET f 1 p)
      list(GET f 2 count)
      list(GET f 3 files)
      _jw_tree_decode(p "${p}" "${where}")
      math(EXPR last "${count} - 1")
      foreach(i RANGE ${last})
        math(EXPR z "1000 + ${i}")
        string(SUBSTRING "${z}" 1 3 z)
        file(WRITE "${root}/${p}/p${z}/basic.ini" "x")
        foreach(j RANGE 1 ${files})
          math(EXPR y "1000 + ${j}")
          string(SUBSTRING "${y}" 1 3 y)
          file(WRITE "${root}/${p}/p${z}/u${y}.txt" "x")
        endforeach()
      endforeach()
    else()
      message(FATAL_ERROR "${where}: cannot read '${line}'")
    endif()
  endforeach()
  set_property(GLOBAL PROPERTY JW_TREE_${name} "")
  set(${skipvar} "" PARENT_SCOPE)
endfunction()

# The JSON text of string <s>, for string(JSON SET).
function(_jw_json_quote out s)
  string(REPLACE "\\" "\\\\" s "${s}")
  string(REPLACE "\"" "\\\"" s "${s}")
  set(${out} "\"${s}\"" PARENT_SCOPE)
endfunction()

# The canonical form of a plan document, the form in which plan outputs are compared:
#   - inside each run of consecutive stored entries of one profile, of one collection, or of the module
#     configs (role module.*), the entries are sorted by path (the contract fixes the order of the runs,
#     not the order inside one);
#   - ids are then renumbered e1, e2, ... and every bak follows its entry;
#   - a profiles item whose dir is "basic/profiles/<d>" gets dir "<d>" (the contract names the member
#     dir and does not say which of the two);
#   - warnings are sorted.
# With <check> TRUE (an actual output), <whyvar> is set when the ids are not e1, e2, ... in entry order
# or when a bak names no entry; the document is then returned unchanged.
function(_jw_plan_canon outvar whyvar doc check)
  set(${outvar} "${doc}" PARENT_SCOPE)
  set(${whyvar} "" PARENT_SCOPE)
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" entries)
  if(NOT t STREQUAL "ARRAY")
    return()
  endif()
  string(JSON ents GET "${doc}" entries)
  string(JSON n LENGTH "${ents}")
  set(why "")
  set(ids "")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON ent_${i} GET "${ents}" ${i})
      string(JSON t ERROR_VARIABLE e TYPE "${ent_${i}}")
      if(NOT t STREQUAL "OBJECT")
        if(check)
          set(${whyvar} "entries/${i} is not an object" PARENT_SCOPE)
        endif()
        return()
      endif()
      string(JSON id_${i} ERROR_VARIABLE e GET "${ent_${i}}" id)
      math(EXPR k "${i} + 1")
      if(NOT id_${i} STREQUAL "e${k}")
        if(check)
          set(${whyvar} "entries/${i}/id is '${id_${i}}', expected e${k} (ids number the entries in plan order)" PARENT_SCOPE)
        endif()
        return()
      endif()
      list(APPEND ids "${id_${i}}")
      string(JSON path_${i} ERROR_VARIABLE e GET "${ent_${i}}" path)
      string(JSON st ERROR_VARIABLE e GET "${ent_${i}}" status)
      set(g "")
      if(st STREQUAL "stored")
        string(JSON v ERROR_VARIABLE e GET "${ent_${i}}" profile)
        if(e STREQUAL "NOTFOUND")
          set(g "p:${v}")
        else()
          string(JSON v ERROR_VARIABLE e GET "${ent_${i}}" collection)
          if(e STREQUAL "NOTFOUND")
            set(g "c:${v}")
          else()
            string(JSON v ERROR_VARIABLE e GET "${ent_${i}}" role)
            if(v MATCHES "^module[.]")
              set(g "m")
            endif()
          endif()
        endif()
      endif()
      set(g_${i} "${g}")
    endforeach()
    foreach(i RANGE ${last})
      string(JSON b ERROR_VARIABLE e GET "${ent_${i}}" bak)
      if(e STREQUAL "NOTFOUND" AND NOT b IN_LIST ids)
        if(check)
          set(${whyvar} "entries/${i}/bak '${b}' names no entry" PARENT_SCOPE)
        endif()
        return()
      endif()
    endforeach()
  endif()
  # the order: runs sorted by path
  string(ASCII 1 sep)
  set(order "")
  set(i 0)
  while(i LESS n)
    if(g_${i} STREQUAL "")
      list(APPEND order ${i})
      math(EXPR i "${i} + 1")
      continue()
    endif()
    set(keys "")
    set(j ${i})
    while(j LESS n)
      if(NOT "${g_${j}}" STREQUAL "${g_${i}}")
        break()
      endif()
      list(APPEND keys "${path_${j}}${sep}${j}")
      math(EXPR j "${j} + 1")
    endwhile()
    list(SORT keys)
    foreach(kk IN LISTS keys)
      string(FIND "${kk}" "${sep}" p REVERSE)
      math(EXPR p "${p} + 1")
      string(SUBSTRING "${kk}" ${p} -1 idx)
      list(APPEND order ${idx})
    endforeach()
    set(i ${j})
  endwhile()
  set(k 0)
  foreach(i IN LISTS order)
    math(EXPR k "${k} + 1")
    set(new_${id_${i}} "e${k}")
  endforeach()
  set(arr "")
  set(k 0)
  foreach(i IN LISTS order)
    math(EXPR k "${k} + 1")
    set(ent "${ent_${i}}")
    string(JSON ent SET "${ent}" id "\"e${k}\"")
    string(JSON b ERROR_VARIABLE e GET "${ent}" bak)
    if(e STREQUAL "NOTFOUND" AND DEFINED new_${b})
      string(JSON ent SET "${ent}" bak "\"${new_${b}}\"")
    endif()
    if(k GREATER 1)
      string(APPEND arr ",")
    endif()
    string(APPEND arr "${ent}")
  endforeach()
  string(JSON doc SET "${doc}" entries "[${arr}]")
  # profiles dir
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" profiles)
  if(t STREQUAL "ARRAY")
    string(JSON n LENGTH "${doc}" profiles)
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      foreach(i RANGE ${last})
        string(JSON d ERROR_VARIABLE e GET "${doc}" profiles ${i} dir)
        if(e STREQUAL "NOTFOUND" AND d MATCHES "^basic/profiles/([^/]+)$")
          _jw_json_quote(q "${CMAKE_MATCH_1}")
          string(JSON doc SET "${doc}" profiles ${i} dir "${q}")
        endif()
      endforeach()
    endif()
  endif()
  # warnings
  string(JSON t ERROR_VARIABLE e TYPE "${doc}" warnings)
  if(t STREQUAL "ARRAY")
    string(JSON n LENGTH "${doc}" warnings)
    if(n GREATER 1)
      set(ws "")
      math(EXPR last "${n} - 1")
      foreach(i RANGE ${last})
        string(JSON w GET "${doc}" warnings ${i})
        list(APPEND ws "${w}")
      endforeach()
      list(SORT ws)
      string(JOIN "," arr ${ws})
      string(JSON doc SET "${doc}" warnings "[${arr}]")
    endif()
  endif()
  set(${outvar} "${doc}" PARENT_SCOPE)
endfunction()

# The uid values of a plan document, collections first, then profiles, in their order.
function(_jw_plan_uids out doc)
  set(us "")
  foreach(a IN ITEMS collections profiles)
    string(JSON t ERROR_VARIABLE e TYPE "${doc}" ${a})
    if(t STREQUAL "ARRAY")
      string(JSON n LENGTH "${doc}" ${a})
      if(n GREATER 0)
        math(EXPR last "${n} - 1")
        foreach(i RANGE ${last})
          string(JSON u ERROR_VARIABLE e GET "${doc}" ${a} ${i} uid)
          list(APPEND us "${u}")
        endforeach()
      endif()
    endif()
  endforeach()
  set(${out} "${us}" PARENT_SCOPE)
endfunction()

# uids=random: every uid is a distinct lowercase UUIDv4. Each is then replaced, in the order of
# _jw_plan_uids, by uid-random-0001, uid-random-0002, ... everywhere in the document.
function(_jw_plan_random_uids outvar whyvar firstvar doc)
  _jw_plan_uids(us "${doc}")
  set(h "[0-9a-f]")
  set(h4 "${h}${h}${h}${h}")
  set(re "^${h4}${h4}-${h4}-4${h}${h}${h}-[89ab]${h}${h}${h}-${h4}${h4}${h4}$")
  set(why "")
  set(seen "")
  set(k 0)
  foreach(u IN LISTS us)
    if(NOT u MATCHES "${re}")
      set(why "uid '${u}' is not a lowercase UUIDv4")
      break()
    endif()
    if(u IN_LIST seen)
      set(why "uid '${u}' is given twice")
      break()
    endif()
    list(APPEND seen "${u}")
    math(EXPR k "${k} + 1")
    math(EXPR z "10000 + ${k}")
    string(SUBSTRING "${z}" 1 4 z)
    string(REPLACE "\"${u}\"" "\"uid-random-${z}\"" doc "${doc}")
  endforeach()
  set(first "")
  if(NOT us STREQUAL "")
    list(GET us 0 first)
  endif()
  set(${outvar} "${doc}" PARENT_SCOPE)
  set(${whyvar} "${why}" PARENT_SCOPE)
  set(${firstvar} "${first}" PARENT_SCOPE)
endfunction()

# Checks the stdout of a plan case against @FILE[,FILE...] (JSON equal, in canonical form, to one of them)
# or entries=N (one JSON object with N entries). Sets _jw_pwhy and _jw_pdetail in the caller.
function(_jw_plan_checks idx out)
  set(expect "${_jw_case${idx}_expect}")
  string(STRIP "${out}" o)
  set(why "")
  set(detail "")
  string(LENGTH "${o}" n)
  set(first "")
  set(lastc "")
  if(n GREATER 0)
    string(SUBSTRING "${o}" 0 1 first)
    math(EXPR k "${n} - 1")
    string(SUBSTRING "${o}" ${k} 1 lastc)
  endif()
  set(t "")
  if(first STREQUAL "{" AND lastc STREQUAL "}")
    string(JSON t ERROR_VARIABLE e TYPE "${o}")
  endif()
  if(NOT t STREQUAL "OBJECT")
    _jw_short(s "${out}")
    set(_jw_pwhy "stdout is not exactly one JSON object" "stdout '${s}'" PARENT_SCOPE)
    set(_jw_pdetail "" PARENT_SCOPE)
    return()
  endif()
  if(expect MATCHES "^entries=([0-9]+)$")
    set(want ${CMAKE_MATCH_1})
    string(JSON n ERROR_VARIABLE e LENGTH "${o}" entries)
    if(NOT e STREQUAL "NOTFOUND" OR NOT n EQUAL want)
      set(_jw_pwhy "stdout has ${n} entries, expected ${want}" PARENT_SCOPE)
    else()
      set(_jw_pwhy "" PARENT_SCOPE)
      set(_jw_pdetail "exit ${_jw_rc}, ${n} entries" PARENT_SCOPE)
    endif()
    return()
  endif()
  set(note "")
  if("${_jw_case${idx}_uids}" STREQUAL "random")
    _jw_plan_random_uids(o w first1 "${o}")
    if(NOT w STREQUAL "")
      set(_jw_pwhy "${w}" PARENT_SCOPE)
      set(_jw_pdetail "" PARENT_SCOPE)
      return()
    endif()
    # a second run draws other uids
    _jw_exec(${_jw_argc})
    string(STRIP "${_jw_out}" o2)
    string(JSON t2 ERROR_VARIABLE e TYPE "${o2}")
    if(NOT t2 STREQUAL "OBJECT")
      set(_jw_pwhy "second run: stdout is not one JSON object" PARENT_SCOPE)
      set(_jw_pdetail "" PARENT_SCOPE)
      return()
    endif()
    _jw_plan_random_uids(o2 w first2 "${o2}")
    if(NOT w STREQUAL "" OR first1 STREQUAL first2)
      set(_jw_pwhy "second run: ${w} the first uid is '${first2}' again" PARENT_SCOPE)
      set(_jw_pdetail "" PARENT_SCOPE)
      return()
    endif()
    set(note ", random uids differ between two runs")
  endif()
  _jw_plan_canon(ca w "${o}" TRUE)
  if(NOT w STREQUAL "")
    _jw_short(s "${out}")
    set(_jw_pwhy "${w}" "stdout '${s}'" PARENT_SCOPE)
    set(_jw_pdetail "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${expect}" 1 -1 files)
  string(REPLACE "," ";" files "${files}")
  set(match "")
  foreach(f IN LISTS files)
    file(READ "${CASES_DIR}/${f}" wtext)
    _jw_plan_canon(cw x "${wtext}" FALSE)
    string(JSON eq ERROR_VARIABLE e EQUAL "${cw}" "${ca}")
    if(e STREQUAL "NOTFOUND" AND eq)
      set(match "${f}")
      break()
    endif()
  endforeach()
  if(match STREQUAL "")
    list(GET files 0 f)
    file(READ "${CASES_DIR}/${f}" wtext)
    _jw_plan_canon(cw x "${wtext}" FALSE)
    string(LENGTH "${cw}${ca}" l)
    if(l GREATER 262144)
      set(d "(${l} bytes, not compared member by member)")
    else()
      _jw_json_diff(d "${cw}" "${ca}" "")
    endif()
    _jw_short(s "${out}")
    set(_jw_pwhy "JSON differs from ${f} at ${d}" "stdout '${s}'" PARENT_SCOPE)
    set(_jw_pdetail "" PARENT_SCOPE)
    return()
  endif()
  set(_jw_pwhy "" PARENT_SCOPE)
  set(_jw_pdetail "exit ${_jw_rc}, JSON equal to ${match}${note}" PARENT_SCOPE)
endfunction()

# ------------------------------------------------------------------------------------------------
# run

set(_jw_reserved COMMAND WORKING_DIRECTORY TIMEOUT RESULT_VARIABLE RESULTS_VARIABLE OUTPUT_VARIABLE
    ERROR_VARIABLE INPUT_FILE OUTPUT_FILE ERROR_FILE OUTPUT_QUIET ERROR_QUIET COMMAND_ECHO
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE ENCODING ECHO_OUTPUT_VARIABLE
    ECHO_ERROR_VARIABLE COMMAND_ERROR_IS_FATAL)

message(NOTICE "jw-cases: JW_CHECK=${JW_CHECK}")
message(NOTICE "jw-cases: WORK_DIR=${WORK_DIR}")
set(_jw_pass 0)
set(_jw_fail 0)
set(_jw_skip 0)
set(_jw_failed "")
math(EXPR _jw_last "${_jw_count} - 1")
foreach(_jw_i RANGE ${_jw_last})
  set(_jw_name "${_jw_case${_jw_i}_name}")
  set(_jw_line "${_jw_case${_jw_i}_line}")
  if(DEFINED JW_CASES_FILTER AND NOT _jw_name MATCHES "${JW_CASES_FILTER}")
    continue()
  endif()
  if(CMAKE_HOST_WIN32 AND _jw_name MATCHES "@posix$")
    message(NOTICE "SKIP ${_jw_name} (POSIX only: an argument is not UTF-8 or is a POSIX device, or the tree needs POSIX names or symlinks)")
    math(EXPR _jw_skip "${_jw_skip} + 1")
    continue()
  endif()
  # plan cases: build the tree (once), or skip when this filesystem lacks what it needs
  set(JW_VAR_TREE "")
  if(NOT "${_jw_case${_jw_i}_tree}" STREQUAL "")
    _jw_plan_tree(_jw_tskip "${_jw_case${_jw_i}_tree}")
    if(NOT _jw_tskip STREQUAL "")
      message(NOTICE "SKIP ${_jw_name} (tree ${_jw_case${_jw_i}_tree} ${_jw_tskip})")
      math(EXPR _jw_skip "${_jw_skip} + 1")
      continue()
    endif()
    set(JW_VAR_TREE "${WORK_DIR}/plan/${_jw_case${_jw_i}_tree}")
  endif()

  # arguments; ${OUT} and ${REPORT} are this case's files, deleted before a redact case runs
  set(JW_VAR_OUT "${WORK_DIR}/redact-out/${_jw_name}.out")
  set(JW_VAR_REPORT "${WORK_DIR}/redact-out/${_jw_name}.report.json")
  if(_jw_case${_jw_i}_redact)
    file(REMOVE "${JW_VAR_OUT}" "${JW_VAR_REPORT}")
  endif()
  set(_jw_argc 0)
  string(REGEX REPLACE " +" ";" _jw_tokens "${_jw_case${_jw_i}_args}")
  foreach(_jw_tok IN LISTS _jw_tokens)
    if(_jw_tok STREQUAL "")
      continue()
    endif()
    _jw_decode(_jw_a${_jw_argc} "${_jw_tok}" "${_jw_line}")
    if(_jw_a${_jw_argc} IN_LIST _jw_reserved)
      message(FATAL_ERROR "cases.txt:${_jw_line}: argument '${_jw_tok}' is an execute_process keyword")
    endif()
    math(EXPR _jw_argc "${_jw_argc} + 1")
  endforeach()

  set(_jw_timeout "${_jw_case${_jw_i}_timeout}")
  _jw_exec(${_jw_argc})
  string(REGEX REPLACE "[\r\n]+$" "" _jw_stdout "${_jw_out}")
  set(_jw_expect "${_jw_case${_jw_i}_expect}")

  set(_jw_why "")
  set(_jw_detail "")
  string(REPLACE "," ";" _jw_exits "${_jw_case${_jw_i}_exit}")
  if(NOT "${_jw_rc}" IN_LIST _jw_exits)
    set(_jw_why "exit ${_jw_rc}, expected ${_jw_case${_jw_i}_exit}")
  endif()
  # An OK line comes with exit 0 and an ERR line with exit 1, whatever the case allows.
  if(NOT _jw_expect STREQUAL "*")
    if(_jw_stdout MATCHES "^OK( |$)" AND NOT "${_jw_rc}" STREQUAL "0")
      list(APPEND _jw_why "an OK line with exit ${_jw_rc}")
    elseif(_jw_stdout MATCHES "^ERR " AND NOT "${_jw_rc}" STREQUAL "1")
      list(APPEND _jw_why "an ERR line with exit ${_jw_rc}")
    endif()
  endif()
  if(_jw_expect STREQUAL "*")
    set(_jw_detail "exit ${_jw_rc}")
  elseif(_jw_case${_jw_i}_plan AND _jw_expect MATCHES "^(@|entries=)")
    _jw_plan_checks(${_jw_i} "${_jw_out}")
    list(APPEND _jw_why ${_jw_pwhy})
    set(_jw_detail "${_jw_pdetail}")
  elseif(_jw_expect MATCHES "^@(.+)$")
    file(READ "${CASES_DIR}/${CMAKE_MATCH_1}" _jw_want)
    string(STRIP "${_jw_out}" _jw_o)
    string(LENGTH "${_jw_o}" _jw_n)
    set(_jw_first "")
    set(_jw_lastc "")
    if(_jw_n GREATER 0)
      string(SUBSTRING "${_jw_o}" 0 1 _jw_first)
      math(EXPR _jw_k "${_jw_n} - 1")
      string(SUBSTRING "${_jw_o}" ${_jw_k} 1 _jw_lastc)
    endif()
    set(_jw_jwhy "")
    if(NOT _jw_first STREQUAL "{" OR NOT _jw_lastc STREQUAL "}")
      set(_jw_jwhy "stdout is not exactly one JSON object")
    else()
      string(JSON _jw_eq ERROR_VARIABLE _jw_e EQUAL "${_jw_want}" "${_jw_o}")
      if(NOT _jw_e STREQUAL "NOTFOUND")
        set(_jw_jwhy "stdout is not JSON: ${_jw_e}")
      elseif(NOT _jw_eq)
        _jw_json_diff(_jw_d "${_jw_want}" "${_jw_o}" "")
        set(_jw_jwhy "JSON differs at ${_jw_d}")
      endif()
    endif()
    if(_jw_jwhy STREQUAL "")
      set(_jw_detail "exit ${_jw_rc}, JSON equal to ${CMAKE_MATCH_1}")
    else()
      _jw_short(_jw_s "${_jw_out}")
      list(APPEND _jw_why "${_jw_jwhy}" "stdout '${_jw_s}'")
    endif()
  else()
    _jw_match(_jw_m "${_jw_stdout}" "${_jw_expect}")
    # One line only: an ERR line never comes with JSON or other output (contract r2 item 11).
    if(_jw_m STREQUAL "" AND _jw_stdout MATCHES "[\r\n]")
      set(_jw_m "is more than one line")
    endif()
    _jw_short(_jw_s "${_jw_stdout}")
    if(_jw_m STREQUAL "")
      set(_jw_detail "exit ${_jw_rc}, ${_jw_s}")
    else()
      list(APPEND _jw_why "stdout '${_jw_s}' ${_jw_m}")
    endif()
  endif()
  if(_jw_case${_jw_i}_redact)
    _jw_redact_checks(${_jw_i})
    list(APPEND _jw_why ${_jw_rwhy})
    if(NOT _jw_rdetail STREQUAL "")
      string(APPEND _jw_detail ", ${_jw_rdetail}")
    endif()
  endif()

  if(_jw_why STREQUAL "")
    message(NOTICE "PASS ${_jw_name} (${_jw_detail})")
    math(EXPR _jw_pass "${_jw_pass} + 1")
  else()
    _jw_short(_jw_s "${_jw_err}")
    if(NOT _jw_s STREQUAL "")
      list(APPEND _jw_why "stderr '${_jw_s}'")
    endif()
    list(JOIN _jw_why "; " _jw_why)
    message(NOTICE "FAIL ${_jw_name} (${_jw_why}) cases.txt:${_jw_line}")
    math(EXPR _jw_fail "${_jw_fail} + 1")
    list(APPEND _jw_failed "${_jw_name}")
  endif()
endforeach()

math(EXPR _jw_total "${_jw_pass} + ${_jw_fail} + ${_jw_skip}")
message(NOTICE "jw-cases: ${_jw_pass} passed, ${_jw_fail} failed, ${_jw_skip} skipped, ${_jw_total} run")
if(_jw_fail GREATER 0)
  list(JOIN _jw_failed " " _jw_failed)
  message(FATAL_ERROR "jw-cases: failed: ${_jw_failed}")
endif()
