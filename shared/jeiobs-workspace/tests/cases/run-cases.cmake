# Black-box cases for jw-check, the jeiobs-workspace command-line checker (task 002, S1-PR1 to S1-PR3).
#
#   cmake -DJW_CHECK=<jw-check> -DCASES_DIR=<this directory> -DWORK_DIR=<scratch directory>
#         [-DJW_CASES_FILTER=<regex on case names>] -P run-cases.cmake
#
# Generates the large and byte-level inputs into WORK_DIR, builds the synthetic config trees of the
# plan cases there, runs every case of cases.txt (the format is documented at the top of that file)
# and prints one "PASS|FAIL|SKIP <case> (<detail>)" line per case and a summary. Fails if any case
# fails. The expected values were written from docs/jeiobs/WORKSPACE_FORMAT.md, the S1-PR1, S1-PR2
# and S1-PR3 CLI contracts (with the PR2 review addenda r3, r3.1 and r3.2) and libobs's INI reader
# where they defer to it, not from the implementation. Plain CMake: no shell, no Python. WORK_DIR is
# only written to, never cleaned, except for each redact case's own OUTFILE and REPORT, which are
# deleted before the case runs, and WORK_DIR/plan/<tree> and WORK_DIR/plan-probe, which are removed
# and rebuilt before the first case that uses them. WORK_DIR needs about 700 MB. Some performance
# inputs need tens of GiB in a library without the r3 and r3.2 bounds: cap the memory (for example
# ulimit -v) when running a build that may lack them.

cmake_minimum_required(VERSION 3.28)

# Default per-case timeout in seconds; a redact case may set its own with timeout=N.
set(JW_CASE_TIMEOUT 120)

foreach(_jw_var IN ITEMS JW_CHECK CASES_DIR WORK_DIR)
  if(NOT DEFINED ${_jw_var} OR "${${_jw_var}}" STREQUAL "")
    message(FATAL_ERROR "run-cases.cmake: pass -D${_jw_var}=<path>")
  endif()
  get_filename_component(${_jw_var} "${${_jw_var}}" ABSOLUTE)
endforeach()
if(NOT EXISTS "${JW_CHECK}" OR IS_DIRECTORY "${JW_CHECK}")
  message(FATAL_ERROR "run-cases.cmake: JW_CHECK '${JW_CHECK}' is not a file")
endif()
if(NOT EXISTS "${CASES_DIR}/cases.txt")
  message(FATAL_ERROR "run-cases.cmake: '${CASES_DIR}/cases.txt' not found")
endif()
file(MAKE_DIRECTORY "${WORK_DIR}")

# ------------------------------------------------------------------------------------------------
# Generated inputs. None written by _jw_write contains a newline, because file(WRITE) may
# translate newlines on Windows; every file is checked for its exact size after writing.

function(_jw_write name content)
  file(WRITE "${WORK_DIR}/${name}" "${content}")
  string(LENGTH "${content}" _want)
  file(SIZE "${WORK_DIR}/${name}" _have)
  if(NOT _have EQUAL _want)
    message(FATAL_ERROR "run-cases.cmake: wrote ${_have} bytes to ${name}, expected ${_want}")
  endif()
endfunction()

# Writes text with LF line ends on every platform: file(CONFIGURE) with NEWLINE_STYLE LF writes
# binary. The content must end with LF (file(CONFIGURE) ends the last line itself) and must not
# hold @VAR@, ${VAR}, CR or #cmakedefine, which it would rewrite; the size check catches that.
function(_jw_write_lf name content)
  file(CONFIGURE OUTPUT "${WORK_DIR}/${name}" CONTENT "${content}" @ONLY NEWLINE_STYLE LF)
  string(LENGTH "${content}" _want)
  file(SIZE "${WORK_DIR}/${name}" _have)
  if(NOT _have EQUAL _want)
    message(FATAL_ERROR "run-cases.cmake: wrote ${_have} bytes to ${name}, expected ${_want}")
  endif()
endfunction()

string(JSON _jw_nul GET [=[["\u0000"]]=] 0) # one NUL byte; string(ASCII) cannot produce it
string(ASCII 195 169 _jw_e_acute) # U+00E9 in UTF-8
string(ASCII 26 _jw_ctrl_z)
string(ASCII 255 _jw_ff)

# A minimal valid local manifest, one line. Members: head, label, extra members, entries.
set(_jw_head [=[{"format":"jeiobs-workspace","major":1,"minor":0,"compat":{"incompat":[],"ro_compat":[]},"workspace_id":"0d6f3c1e-8b2a-4c47-9e15-6a0b7d93f2c4","seq":1,"parent":null,"created_utc":"2026-11-16T18:04:05Z","creator":{"app":"jeiobs","version":"0.0.0-dev","commit":"b76d7cdb1","obs_base":"33.0.1"},"active":{"profile":"7b1e4c2a-90d3-4f6e-8a5b-2c1d0e9f8a7b","collection":"c3d2e1f0-4a5b-4c6d-9e8f-0a1b2c3d4e5f"},"target":{"os":"linux","audio":{"sample_rate":48000,"channels":"Stereo"}},"app_keys":[],"secret_refs":[],"dropped_ext":[],]=])
set(_jw_entry1 [=[{"id":"e1","status":"stored","root":"user","path":"user.ini","role":"app.user","fidelity":"exact","size":3120,"hash":"0b8c4d2a9e7f1c3566d2a0b4c8e19f732a5d7c0e91b3f48a6c2e0d17b5a39f84"}]=])

function(_jw_manifest out label extra entries)
  set(${out} "${_jw_head}\"label\":\"${label}\",${extra}\"entries\":[${entries}]}" PARENT_SCOPE)
endfunction()

function(_jw_omitted out path)
  set(${out} "{\"id\":\"e2\",\"status\":\"omitted\",\"root\":\"config\",\"path\":\"${path}\",\"size\":1,\"reason\":\"unknown\"}" PARENT_SCOPE)
endfunction()

# Values that cases.txt can use as ${NAME} inside arguments.
string(REPEAT "a" 254 _jw_a254)
string(REPEAT "a" 255 _jw_a255)
string(REPEAT "b" 255 _jw_b255)
set(JW_VAR_WORK "${WORK_DIR}")
set(JW_VAR_P512 "${_jw_a254}/${_jw_b255}/c") # 512 bytes, 3 components
set(JW_VAR_P513 "${_jw_a255}/${_jw_b255}/c") # 513 bytes, 3 components
set(JW_VAR_C255 "${_jw_a255}")
string(REPEAT "a" 256 JW_VAR_C256)
string(REPEAT "${_jw_e_acute}" 127 _jw_e127)
set(JW_VAR_C255U "${_jw_e127}a") # 255 bytes, 128 characters
string(REPEAT "${_jw_e_acute}" 128 JW_VAR_C256U) # 256 bytes, 128 characters
set(JW_VARS WORK P512 P513 C255 C256 C255U C256U OUT REPORT TREE)

# hash inputs
_jw_write(empty.bin "")
_jw_write(abc.bin "abc")
string(REPEAT "a" 128 _jw_x)
_jw_write(a-128.bin "${_jw_x}")
_jw_write(a-129.bin "${_jw_x}a")
string(REPEAT "a" 1048577 _jw_x)
_jw_write(a-1048577.bin "${_jw_x}")
# Every byte value except LF (0x0A), then CR, Ctrl-Z, CR: a text-mode read changes the hash.
set(_jw_x "${_jw_nul}")
foreach(_jw_i RANGE 1 255)
  if(NOT _jw_i EQUAL 10)
    string(ASCII ${_jw_i} _jw_c)
    string(APPEND _jw_x "${_jw_c}")
  endif()
endforeach()
_jw_write(bytes.bin "${_jw_x}\r${_jw_ctrl_z}\r")

# manifest size: valid manifests padded with spaces to exactly 4 MiB and 4 MiB + 1
_jw_manifest(_jw_m "generated" "" "${_jw_entry1}")
string(LENGTH "${_jw_m}" _jw_len)
foreach(_jw_size IN ITEMS 4194304 4194305)
  math(EXPR _jw_pad "${_jw_size} - ${_jw_len}")
  string(REPEAT " " ${_jw_pad} _jw_x)
  _jw_manifest(_jw_x "generated" "${_jw_x}" "${_jw_entry1}")
  _jw_write(size-${_jw_size}.json "${_jw_x}")
endforeach()

# entry count: 10,000 and 10,001 omitted entries
set(_jw_all "")
set(_jw_chunk "")
foreach(_jw_i RANGE 1 10000)
  string(APPEND _jw_chunk ",{\"id\":\"g${_jw_i}\",\"status\":\"omitted\",\"root\":\"config\",\"path\":\"g/${_jw_i}.json\",\"size\":0,\"reason\":\"unknown\"}")
  math(EXPR _jw_r "${_jw_i} % 256")
  if(_jw_r EQUAL 0)
    string(APPEND _jw_all "${_jw_chunk}")
    set(_jw_chunk "")
  endif()
endforeach()
string(APPEND _jw_all "${_jw_chunk}")
string(SUBSTRING "${_jw_all}" 1 -1 _jw_all)
_jw_manifest(_jw_x "generated" "" "${_jw_all}")
_jw_write(entries-10000.json "${_jw_x}")
_jw_manifest(_jw_x "generated" "" "${_jw_all},{\"id\":\"g10001\",\"status\":\"omitted\",\"root\":\"config\",\"path\":\"g/10001.json\",\"size\":0,\"reason\":\"unknown\"}")
_jw_write(entries-10001.json "${_jw_x}")

# string length: label of 64 KiB and 64 KiB + 1 bytes; an unknown key of 64 KiB + 1 bytes
string(REPEAT "x" 65536 _jw_s)
_jw_manifest(_jw_x "${_jw_s}" "" "${_jw_entry1}")
_jw_write(string-65536.json "${_jw_x}")
_jw_manifest(_jw_x "${_jw_s}x" "" "${_jw_entry1}")
_jw_write(string-65537.json "${_jw_x}")
_jw_manifest(_jw_x "generated" "\"${_jw_s}k\":1," "${_jw_entry1}")
_jw_write(key-65537.json "${_jw_x}")

# value count: an unknown array of 249,000 numbers (under the limit however values are counted)
# and of 250,001 numbers (over it however values are counted)
string(REPEAT "0," 248999 _jw_s)
_jw_manifest(_jw_x "generated" "\"x_values\":[${_jw_s}0]," "${_jw_entry1}")
_jw_write(values-249000.json "${_jw_x}")
string(REPEAT "0," 250000 _jw_s)
_jw_manifest(_jw_x "generated" "\"x_values\":[${_jw_s}0]," "${_jw_entry1}")
_jw_write(values-250001.json "${_jw_x}")

# depth: the top-level object is depth 1, so N nested empty arrays reach depth N + 1
foreach(_jw_n IN ITEMS 63 64 99999)
  string(REPEAT "[" ${_jw_n} _jw_o)
  string(REPEAT "]" ${_jw_n} _jw_c)
  math(EXPR _jw_d "${_jw_n} + 1")
  _jw_manifest(_jw_x "generated" "\"x_deep\":${_jw_o}${_jw_c}," "${_jw_entry1}")
  _jw_write(depth-${_jw_d}.json "${_jw_x}")
endforeach()
string(REPEAT "{\"a\":" 63 _jw_o)
string(REPEAT "}" 63 _jw_c)
_jw_manifest(_jw_x "generated" "\"x_deep\":${_jw_o}{}${_jw_c}," "${_jw_entry1}")
_jw_write(depth-65-objects.json "${_jw_x}")

# path length limits inside a manifest
foreach(_jw_p IN ITEMS P512 P513 C255 C256)
  _jw_omitted(_jw_e "${JW_VAR_${_jw_p}}")
  _jw_manifest(_jw_x "generated" "" "${_jw_entry1},${_jw_e}")
  set(_jw_name_P512 path-512.json)
  set(_jw_name_P513 path-513.json)
  set(_jw_name_C255 component-255.json)
  set(_jw_name_C256 component-256.json)
  _jw_write(${_jw_name_${_jw_p}} "${_jw_x}")
endforeach()

# byte-level parser faults
string(ASCII 239 187 191 _jw_bom)
_jw_write(bom.json "${_jw_bom}${_jw_m}")
set(_jw_utf8_ff 255)
set(_jw_utf8_80 128)
set(_jw_utf8_overlong 192 175) # overlong "/"
set(_jw_utf8_surrogate 237 160 128) # U+D800
set(_jw_utf8_above-10ffff 244 144 128 128) # U+110000
set(_jw_utf8_truncated 195) # lead byte, then the closing quote
foreach(_jw_k IN ITEMS ff 80 overlong surrogate above-10ffff truncated)
  string(ASCII ${_jw_utf8_${_jw_k}} _jw_b)
  if(_jw_k STREQUAL "truncated")
    set(_jw_lab "a${_jw_b}")
  else()
    set(_jw_lab "a${_jw_b}b")
  endif()
  _jw_manifest(_jw_x "${_jw_lab}" "" "${_jw_entry1}")
  _jw_write(utf8-${_jw_k}.json "${_jw_x}")
endforeach()
_jw_manifest(_jw_x "generated" "\"x_${_jw_ff}\":1," "${_jw_entry1}")
_jw_write(utf8-key.json "${_jw_x}")
# Built at this scope: string(REPLACE) and set(PARENT_SCOPE) cut a value at its first NUL.
set(_jw_x "${_jw_head}\"label\":\"a${_jw_nul}b\",\"entries\":[${_jw_entry1}]}")
_jw_write(nul-in-string.json "${_jw_x}")
_jw_write(nul-trailing.json "${_jw_m}${_jw_nul}")
foreach(_jw_f IN ITEMS nul-in-string nul-trailing)
  file(READ "${WORK_DIR}/${_jw_f}.json" _jw_x HEX)
  set(_jw_want_nul-in-string "^.*226c6162656c223a2261006222.*$") # "label":"a<NUL>b"
  set(_jw_want_nul-trailing "^.*7d00$")
  if(NOT _jw_x MATCHES "${_jw_want_${_jw_f}}")
    message(FATAL_ERROR "run-cases.cmake: ${_jw_f}.json lacks its NUL byte")
  endif()
endforeach()
string(REPLACE ",\"" ",\r\t \"" _jw_x "${_jw_m}")
_jw_write(whitespace-cr-tab.json "\t${_jw_x}\r")

# revision size (contract r2 item 9): the two 4 MiB manifests above, stored under revision names.
# CMake has no BLAKE2b, so the names were computed when the cases were written; the SHA-256 check
# fails here if the generated bytes ever change.
set(_jw_rev_b2_4194304 1f3a084845ee020b475189f57eff0dddb61be58856ca728e8dcc4250e969a03b)
set(_jw_rev_sha256_4194304 00568f9bd8e37fc22c04fd9c4eebda2eba55b1e94b555f9ee6cd72523644a3d8)
set(_jw_rev_b2_4194305 611dbb4c3483765adc22312022c809a126ce3443527c304aa0a010ae2a582d40)
set(_jw_rev_sha256_4194305 e18cb273bdc0acc43e2a32b51de10b2cb97ae2c7ce376e43625d12dcafa43fea)
foreach(_jw_size IN ITEMS 4194304 4194305)
  file(SHA256 "${WORK_DIR}/size-${_jw_size}.json" _jw_x)
  if(NOT _jw_x STREQUAL "${_jw_rev_sha256_${_jw_size}}")
    message(FATAL_ERROR "run-cases.cmake: size-${_jw_size}.json changed: recompute _jw_rev_b2_${_jw_size}")
  endif()
  file(MAKE_DIRECTORY "${WORK_DIR}/rev-${_jw_size}")
  file(COPY_FILE "${WORK_DIR}/size-${_jw_size}.json"
       "${WORK_DIR}/rev-${_jw_size}/0000000001-${_jw_rev_b2_${_jw_size}}.json")
endforeach()
# a directory with a revision name, and (POSIX) a revision name that resolves to /dev/zero
file(MAKE_DIRECTORY
     "${WORK_DIR}/rev-dir/0000000003-974beab28a55fbd22b4918fba9a31e1e33248d9a9cb30b079da71f137ac72552.json")
if(NOT CMAKE_HOST_WIN32)
  file(MAKE_DIRECTORY "${WORK_DIR}/rev-dev")
  file(CREATE_LINK /dev/zero
       "${WORK_DIR}/rev-dev/0000000003-974beab28a55fbd22b4918fba9a31e1e33248d9a9cb30b079da71f137ac72552.json"
       RESULT _jw_x SYMBOLIC)
  if(NOT _jw_x STREQUAL "0")
    message(FATAL_ERROR "run-cases.cmake: cannot create the /dev/zero link: ${_jw_x}")
  endif()
endif()

# DECISIONS files for fixtures/local-example.json (contract r2 item 4): byte-level faults, sizes
# around 4 MiB and an unknown id around the 64 KiB string limit
set(_jw_dec [=[{"e2":{"decision":"include","fidelity":"exact"},"e3":{"decision":"omit"}]=]) # no "}"
_jw_write(decisions-bom.json "${_jw_bom}${_jw_dec}}")
_jw_write(decisions-utf8.json "{\"e2\":{\"decision\":\"include\"},\"e3\":{\"decision\":\"omit${_jw_ff}\"}}")
_jw_write(decisions-nul.json "${_jw_dec}}${_jw_nul}")
file(READ "${WORK_DIR}/decisions-nul.json" _jw_x HEX)
if(NOT _jw_x MATCHES "^.*7d7d00$")
  message(FATAL_ERROR "run-cases.cmake: decisions-nul.json lacks its NUL byte")
endif()
string(LENGTH "${_jw_dec}" _jw_len)
foreach(_jw_size IN ITEMS 4194304 4194305)
  math(EXPR _jw_pad "${_jw_size} - ${_jw_len} - 1")
  string(REPEAT " " ${_jw_pad} _jw_x)
  _jw_write(decisions-${_jw_size}.json "${_jw_dec}${_jw_x}}")
endforeach()
foreach(_jw_n IN ITEMS 65536 65537)
  string(REPEAT "x" ${_jw_n} _jw_x)
  _jw_write(decisions-key-${_jw_n}.json "${_jw_dec},\"${_jw_x}\":{\"decision\":\"omit\"}}")
endforeach()

# child inputs (contract r2 item 10): each one is valid, but a child carrying the parent's unknown
# field on top of the draft's own passes the 250,000 values limit, or the 4 MiB limit
string(REPEAT "0," 248999 _jw_s)
_jw_manifest(_jw_x "child parent" "\"x_parent_values\":[${_jw_s}0]," "${_jw_entry1}")
_jw_write(child-values-parent.json "${_jw_x}")
_jw_manifest(_jw_x "child draft" "\"x_draft_values\":[${_jw_s}0]," "${_jw_entry1}")
_jw_write(child-values-draft.json "${_jw_x}")
string(REPEAT "x" 65536 _jw_s)
string(REPEAT "\"${_jw_s}\"," 47 _jw_y) # 48 strings of 64 KiB: about 3 MiB per input
_jw_manifest(_jw_x "child parent" "\"x_parent_blob\":[${_jw_y}\"${_jw_s}\"]," "${_jw_entry1}")
_jw_write(child-size-parent.json "${_jw_x}")
_jw_manifest(_jw_x "child draft" "\"x_draft_blob\":[${_jw_y}\"${_jw_s}\"]," "${_jw_entry1}")
_jw_write(child-size-draft.json "${_jw_x}")

# ------------------------------------------------------------------------------------------------
# redact inputs (S1-PR2, section 12 limits for documents, and byte-level faults) in WORK_DIR/redact.
# JSON inputs are one line. An INI input starts with a committed prefix (fixtures/redact/prefix/),
# copied byte for byte, with only bytes without a newline appended to it, or is written whole by
# _jw_write_lf. SECRETvalue and PLAINvalue markers in generated inputs mean what they mean in the
# fixtures: every stored OUTFILE is scanned for them, also over 4 MiB.

file(MAKE_DIRECTORY "${WORK_DIR}/redact" "${WORK_DIR}/redact-out")

function(_jw_check_size name want)
  file(SIZE "${WORK_DIR}/${name}" _have)
  if(NOT _have EQUAL want)
    message(FATAL_ERROR "run-cases.cmake: ${name} has ${_have} bytes, expected ${want}")
  endif()
endfunction()

# depth: the top-level object is depth 1, so N nested arrays reach depth N + 1
foreach(_jw_n IN ITEMS 63 64 99999)
  string(REPEAT "[" ${_jw_n} _jw_o)
  string(REPEAT "]" ${_jw_n} _jw_c)
  math(EXPR _jw_d "${_jw_n} + 1")
  _jw_write(redact/depth-${_jw_d}.json "{\"x\":${_jw_o}${_jw_c}}")
endforeach()
string(REPEAT "{\"a\":" 63 _jw_o)
string(REPEAT "}" 63 _jw_c)
_jw_write(redact/depth-65-objects.json "{\"x\":${_jw_o}{}${_jw_c}}")

