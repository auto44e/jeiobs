# Black-box cases for jw-check, the jeiobs-workspace command-line checker (task 002, S1-PR1).
#
#   cmake -DJW_CHECK=<jw-check> -DCASES_DIR=<this directory> -DWORK_DIR=<scratch directory>
#         [-DJW_CASES_FILTER=<regex on case names>] -P run-cases.cmake
#
# Generates the large and byte-level inputs into WORK_DIR, runs every case of cases.txt (the
# format is documented at the top of that file) and prints one "PASS|FAIL|SKIP <case> (<detail>)"
# line per case and a summary. Fails if any case fails. The expected values were written from
# docs/jeiobs/WORKSPACE_FORMAT.md and the S1-PR1 CLI contract, not from the implementation.
# Plain CMake: no shell, no Python. WORK_DIR is only written to, never cleaned.

cmake_minimum_required(VERSION 3.28)

set(JW_CASE_TIMEOUT 120)

foreach(_jw_var IN ITEMS JW_CHECK CASES_DIR WORK_DIR)
  if(NOT DEFINED ${_jw_var} OR "${${_jw_var}}" STREQUAL "")
    message(FATAL_ERROR "run-cases.cmake: pass -D${_jw_var}=<path>")
  endif()
  get_filename_component(${_jw_var} "${${_jw_var}}" ABSOLUTE)
endforeach()
if(NOT EXISTS "${JW_CHECK}" OR IS_DIRECTORY "${JW_CHECK}")
  message(FATAL_ERROR "run-cases.cmake: JW_CHECK '${JW_CHECK}' is not a file")
endif()
if(NOT EXISTS "${CASES_DIR}/cases.txt")
  message(FATAL_ERROR "run-cases.cmake: '${CASES_DIR}/cases.txt' not found")
endif()
file(MAKE_DIRECTORY "${WORK_DIR}")

# ------------------------------------------------------------------------------------------------
# Generated inputs. None contains a newline, because file(WRITE) may translate newlines on
# Windows; every file is checked for its exact size after writing.

function(_jw_write name content)
  file(WRITE "${WORK_DIR}/${name}" "${content}")
  string(LENGTH "${content}" _want)
  file(SIZE "${WORK_DIR}/${name}" _have)
  if(NOT _have EQUAL _want)
    message(FATAL_ERROR "run-cases.cmake: wrote ${_have} bytes to ${name}, expected ${_want}")
  endif()
endfunction()

string(JSON _jw_nul GET [=[["\u0000"]]=] 0) # one NUL byte; string(ASCII) cannot produce it
string(ASCII 195 169 _jw_e_acute) # U+00E9 in UTF-8
string(ASCII 26 _jw_ctrl_z)
string(ASCII 255 _jw_ff)

# A minimal valid local manifest, one line. Members: head, label, extra members, entries.
set(_jw_head [=[{"format":"jeiobs-workspace","major":1,"minor":0,"compat":{"incompat":[],"ro_compat":[]},"workspace_id":"0d6f3c1e-8b2a-4c47-9e15-6a0b7d93f2c4","seq":1,"parent":null,"created_utc":"2026-11-16T18:04:05Z","creator":{"app":"jeiobs","version":"0.0.0-dev","commit":"b76d7cdb1","obs_base":"33.0.1"},"active":{"profile":"7b1e4c2a-90d3-4f6e-8a5b-2c1d0e9f8a7b","collection":"c3d2e1f0-4a5b-4c6d-9e8f-0a1b2c3d4e5f"},"target":{"os":"linux","audio":{"sample_rate":48000,"channels":"Stereo"}},"app_keys":[],"secret_refs":[],"dropped_ext":[],]=])
set(_jw_entry1 [=[{"id":"e1","status":"stored","root":"user","path":"user.ini","role":"app.user","fidelity":"exact","size":3120,"hash":"0b8c4d2a9e7f1c3566d2a0b4c8e19f732a5d7c0e91b3f48a6c2e0d17b5a39f84"}]=])

function(_jw_manifest out label extra entries)
  set(${out} "${_jw_head}\"label\":\"${label}\",${extra}\"entries\":[${entries}]}" PARENT_SCOPE)
endfunction()

function(_jw_omitted out path)
  set(${out} "{\"id\":\"e2\",\"status\":\"omitted\",\"root\":\"config\",\"path\":\"${path}\",\"size\":1,\"reason\":\"unknown\"}" PARENT_SCOPE)
endfunction()

# Values that cases.txt can use as ${NAME} inside arguments.
string(REPEAT "a" 254 _jw_a254)
string(REPEAT "a" 255 _jw_a255)
string(REPEAT "b" 255 _jw_b255)
set(JW_VAR_WORK "${WORK_DIR}")
set(JW_VAR_P512 "${_jw_a254}/${_jw_b255}/c") # 512 bytes, 3 components
set(JW_VAR_P513 "${_jw_a255}/${_jw_b255}/c") # 513 bytes, 3 components
set(JW_VAR_C255 "${_jw_a255}")
string(REPEAT "a" 256 JW_VAR_C256)
string(REPEAT "${_jw_e_acute}" 127 _jw_e127)
set(JW_VAR_C255U "${_jw_e127}a") # 255 bytes, 128 characters
string(REPEAT "${_jw_e_acute}" 128 JW_VAR_C256U) # 256 bytes, 128 characters
set(JW_VARS WORK P512 P513 C255 C256 C255U C256U)

# hash inputs
_jw_write(empty.bin "")
_jw_write(abc.bin "abc")
string(REPEAT "a" 128 _jw_x)
_jw_write(a-128.bin "${_jw_x}")
_jw_write(a-129.bin "${_jw_x}a")
string(REPEAT "a" 1048577 _jw_x)
_jw_write(a-1048577.bin "${_jw_x}")
# Every byte value except LF (0x0A), then CR, Ctrl-Z, CR: a text-mode read changes the hash.
set(_jw_x "${_jw_nul}")
foreach(_jw_i RANGE 1 255)
  if(NOT _jw_i EQUAL 10)
    string(ASCII ${_jw_i} _jw_c)
    string(APPEND _jw_x "${_jw_c}")
  endif()
endforeach()
_jw_write(bytes.bin "${_jw_x}\r${_jw_ctrl_z}\r")

# manifest size: valid manifests padded with spaces to exactly 4 MiB and 4 MiB + 1
_jw_manifest(_jw_m "generated" "" "${_jw_entry1}")
string(LENGTH "${_jw_m}" _jw_len)
foreach(_jw_size IN ITEMS 4194304 4194305)
  math(EXPR _jw_pad "${_jw_size} - ${_jw_len}")
  string(REPEAT " " ${_jw_pad} _jw_x)
  _jw_manifest(_jw_x "generated" "${_jw_x}" "${_jw_entry1}")
  _jw_write(size-${_jw_size}.json "${_jw_x}")
endforeach()

# entry count: 10,000 and 10,001 omitted entries
set(_jw_all "")
set(_jw_chunk "")
foreach(_jw_i RANGE 1 10000)
  string(APPEND _jw_chunk ",{\"id\":\"g${_jw_i}\",\"status\":\"omitted\",\"root\":\"config\",\"path\":\"g/${_jw_i}.json\",\"size\":0,\"reason\":\"unknown\"}")
  math(EXPR _jw_r "${_jw_i} % 256")
  if(_jw_r EQUAL 0)
    string(APPEND _jw_all "${_jw_chunk}")
    set(_jw_chunk "")
  endif()
endforeach()
string(APPEND _jw_all "${_jw_chunk}")
string(SUBSTRING "${_jw_all}" 1 -1 _jw_all)
_jw_manifest(_jw_x "generated" "" "${_jw_all}")
_jw_write(entries-10000.json "${_jw_x}")
_jw_manifest(_jw_x "generated" "" "${_jw_all},{\"id\":\"g10001\",\"status\":\"omitted\",\"root\":\"config\",\"path\":\"g/10001.json\",\"size\":0,\"reason\":\"unknown\"}")
_jw_write(entries-10001.json "${_jw_x}")

# string length: label of 64 KiB and 64 KiB + 1 bytes; an unknown key of 64 KiB + 1 bytes
string(REPEAT "x" 65536 _jw_s)
_jw_manifest(_jw_x "${_jw_s}" "" "${_jw_entry1}")
_jw_write(string-65536.json "${_jw_x}")
_jw_manifest(_jw_x "${_jw_s}x" "" "${_jw_entry1}")
_jw_write(string-65537.json "${_jw_x}")
_jw_manifest(_jw_x "generated" "\"${_jw_s}k\":1," "${_jw_entry1}")
_jw_write(key-65537.json "${_jw_x}")

# value count: an unknown array of 249,000 numbers (under the limit however values are counted)
# and of 250,001 numbers (over it however values are counted)
string(REPEAT "0," 248999 _jw_s)
_jw_manifest(_jw_x "generated" "\"x_values\":[${_jw_s}0]," "${_jw_entry1}")
_jw_write(values-249000.json "${_jw_x}")
string(REPEAT "0," 250000 _jw_s)
_jw_manifest(_jw_x "generated" "\"x_values\":[${_jw_s}0]," "${_jw_entry1}")
_jw_write(values-250001.json "${_jw_x}")

# depth: the top-level object is depth 1, so N nested empty arrays reach depth N + 1
foreach(_jw_n IN ITEMS 63 64 99999)
  string(REPEAT "[" ${_jw_n} _jw_o)
  string(REPEAT "]" ${_jw_n} _jw_c)
  math(EXPR _jw_d "${_jw_n} + 1")
  _jw_manifest(_jw_x "generated" "\"x_deep\":${_jw_o}${_jw_c}," "${_jw_entry1}")
  _jw_write(depth-${_jw_d}.json "${_jw_x}")
endforeach()
string(REPEAT "{\"a\":" 63 _jw_o)
string(REPEAT "}" 63 _jw_c)
_jw_manifest(_jw_x "generated" "\"x_deep\":${_jw_o}{}${_jw_c}," "${_jw_entry1}")
_jw_write(depth-65-objects.json "${_jw_x}")

# path length limits inside a manifest
foreach(_jw_p IN ITEMS P512 P513 C255 C256)
  _jw_omitted(_jw_e "${JW_VAR_${_jw_p}}")
  _jw_manifest(_jw_x "generated" "" "${_jw_entry1},${_jw_e}")
  set(_jw_name_P512 path-512.json)
  set(_jw_name_P513 path-513.json)
  set(_jw_name_C255 component-255.json)
  set(_jw_name_C256 component-256.json)
  _jw_write(${_jw_name_${_jw_p}} "${_jw_x}")
endforeach()

# byte-level parser faults
string(ASCII 239 187 191 _jw_bom)
_jw_write(bom.json "${_jw_bom}${_jw_m}")
set(_jw_utf8_ff 255)
set(_jw_utf8_80 128)
set(_jw_utf8_overlong 192 175) # overlong "/"
set(_jw_utf8_surrogate 237 160 128) # U+D800
set(_jw_utf8_above-10ffff 244 144 128 128) # U+110000
set(_jw_utf8_truncated 195) # lead byte, then the closing quote
foreach(_jw_k IN ITEMS ff 80 overlong surrogate above-10ffff truncated)
  string(ASCII ${_jw_utf8_${_jw_k}} _jw_b)
  if(_jw_k STREQUAL "truncated")
    set(_jw_lab "a${_jw_b}")
  else()
    set(_jw_lab "a${_jw_b}b")
  endif()
  _jw_manifest(_jw_x "${_jw_lab}" "" "${_jw_entry1}")
  _jw_write(utf8-${_jw_k}.json "${_jw_x}")
endforeach()
_jw_manifest(_jw_x "generated" "\"x_${_jw_ff}\":1," "${_jw_entry1}")
_jw_write(utf8-key.json "${_jw_x}")
# Built at this scope: string(REPLACE) and set(PARENT_SCOPE) cut a value at its first NUL.
set(_jw_x "${_jw_head}\"label\":\"a${_jw_nul}b\",\"entries\":[${_jw_entry1}]}")
_jw_write(nul-in-string.json "${_jw_x}")
_jw_write(nul-trailing.json "${_jw_m}${_jw_nul}")
foreach(_jw_f IN ITEMS nul-in-string nul-trailing)
  file(READ "${WORK_DIR}/${_jw_f}.json" _jw_x HEX)
  set(_jw_want_nul-in-string "^.*226c6162656c223a2261006222.*$") # "label":"a<NUL>b"
  set(_jw_want_nul-trailing "^.*7d00$")
  if(NOT _jw_x MATCHES "${_jw_want_${_jw_f}}")
    message(FATAL_ERROR "run-cases.cmake: ${_jw_f}.json lacks its NUL byte")
  endif()
endforeach()
string(REPLACE ",\"" ",\r\t \"" _jw_x "${_jw_m}")
_jw_write(whitespace-cr-tab.json "\t${_jw_x}\r")

# revision size (contract r2 item 9): the two 4 MiB manifests above, stored under revision names.
# CMake has no BLAKE2b, so the names were computed when the cases were written; the SHA-256 check
# fails here if the generated bytes ever change.
set(_jw_rev_b2_4194304 1f3a084845ee020b475189f57eff0dddb61be58856ca728e8dcc4250e969a03b)
set(_jw_rev_sha256_4194304 00568f9bd8e37fc22c04fd9c4eebda2eba55b1e94b555f9ee6cd72523644a3d8)
set(_jw_rev_b2_4194305 611dbb4c3483765adc22312022c809a126ce3443527c304aa0a010ae2a582d40)
set(_jw_rev_sha256_4194305 e18cb273bdc0acc43e2a32b51de10b2cb97ae2c7ce376e43625d12dcafa43fea)
foreach(_jw_size IN ITEMS 4194304 4194305)
  file(SHA256 "${WORK_DIR}/size-${_jw_size}.json" _jw_x)
  if(NOT _jw_x STREQUAL "${_jw_rev_sha256_${_jw_size}}")
    message(FATAL_ERROR "run-cases.cmake: size-${_jw_size}.json changed: recompute _jw_rev_b2_${_jw_size}")
  endif()
  file(MAKE_DIRECTORY "${WORK_DIR}/rev-${_jw_size}")
  file(COPY_FILE "${WORK_DIR}/size-${_jw_size}.json"
       "${WORK_DIR}/rev-${_jw_size}/0000000001-${_jw_rev_b2_${_jw_size}}.json")
endforeach()
# a directory with a revision name, and (POSIX) a revision name that resolves to /dev/zero
file(MAKE_DIRECTORY
     "${WORK_DIR}/rev-dir/0000000003-974beab28a55fbd22b4918fba9a31e1e33248d9a9cb30b079da71f137ac72552.json")
if(NOT CMAKE_HOST_WIN32)
  file(MAKE_DIRECTORY "${WORK_DIR}/rev-dev")
  file(CREATE_LINK /dev/zero
       "${WORK_DIR}/rev-dev/0000000003-974beab28a55fbd22b4918fba9a31e1e33248d9a9cb30b079da71f137ac72552.json"
       RESULT _jw_x SYMBOLIC)
  if(NOT _jw_x STREQUAL "0")
    message(FATAL_ERROR "run-cases.cmake: cannot create the /dev/zero link: ${_jw_x}")
  endif()
endif()

# DECISIONS files for fixtures/local-example.json (contract r2 item 4): byte-level faults, sizes
# around 4 MiB and an unknown id around the 64 KiB string limit
set(_jw_dec [=[{"e2":{"decision":"include","fidelity":"exact"},"e3":{"decision":"omit"}]=]) # no "}"
_jw_write(decisions-bom.json "${_jw_bom}${_jw_dec}}")
_jw_write(decisions-utf8.json "{\"e2\":{\"decision\":\"include\"},\"e3\":{\"decision\":\"omit${_jw_ff}\"}}")
_jw_write(decisions-nul.json "${_jw_dec}}${_jw_nul}")
file(READ "${WORK_DIR}/decisions-nul.json" _jw_x HEX)
if(NOT _jw_x MATCHES "^.*7d7d00$")
  message(FATAL_ERROR "run-cases.cmake: decisions-nul.json lacks its NUL byte")
endif()
string(LENGTH "${_jw_dec}" _jw_len)
foreach(_jw_size IN ITEMS 4194304 4194305)
  math(EXPR _jw_pad "${_jw_size} - ${_jw_len} - 1")
  string(REPEAT " " ${_jw_pad} _jw_x)
  _jw_write(decisions-${_jw_size}.json "${_jw_dec}${_jw_x}}")
endforeach()
foreach(_jw_n IN ITEMS 65536 65537)
  string(REPEAT "x" ${_jw_n} _jw_x)
  _jw_write(decisions-key-${_jw_n}.json "${_jw_dec},\"${_jw_x}\":{\"decision\":\"omit\"}}")
endforeach()

# child inputs (contract r2 item 10): each one is valid, but a child carrying the parent's unknown
# field on top of the draft's own passes the 250,000 values limit, or the 4 MiB limit
string(REPEAT "0," 248999 _jw_s)
_jw_manifest(_jw_x "child parent" "\"x_parent_values\":[${_jw_s}0]," "${_jw_entry1}")
_jw_write(child-values-parent.json "${_jw_x}")
_jw_manifest(_jw_x "child draft" "\"x_draft_values\":[${_jw_s}0]," "${_jw_entry1}")
_jw_write(child-values-draft.json "${_jw_x}")
string(REPEAT "x" 65536 _jw_s)
string(REPEAT "\"${_jw_s}\"," 47 _jw_y) # 48 strings of 64 KiB: about 3 MiB per input
_jw_manifest(_jw_x "child parent" "\"x_parent_blob\":[${_jw_y}\"${_jw_s}\"]," "${_jw_entry1}")
_jw_write(child-size-parent.json "${_jw_x}")
_jw_manifest(_jw_x "child draft" "\"x_draft_blob\":[${_jw_y}\"${_jw_s}\"]," "${_jw_entry1}")
_jw_write(child-size-draft.json "${_jw_x}")

# ------------------------------------------------------------------------------------------------
# cases.txt

file(READ "${CASES_DIR}/cases.txt" _jw_text)
string(REPLACE "\r" "" _jw_text "${_jw_text}")
foreach(_jw_bad IN ITEMS semicolon bracket-open bracket-close backslash)
  set(_jw_ch_semicolon ";")
  set(_jw_ch_bracket-open "[")
  set(_jw_ch_bracket-close "]")
  set(_jw_ch_backslash "\\")
  string(FIND "${_jw_text}" "${_jw_ch_${_jw_bad}}" _jw_pos)
  if(NOT _jw_pos EQUAL -1)
    message(FATAL_ERROR "cases.txt: no ${_jw_bad} allowed (byte offset ${_jw_pos}), use %XX")
  endif()
endforeach()
# Every line gets a ">" prefix so that empty lines stay list elements and line numbers hold.
string(REPLACE "\n" ";>" _jw_lines ">${_jw_text}")

set(_jw_count 0)
set(_jw_names "")
set(_jw_lineno 0)
foreach(_jw_raw IN LISTS _jw_lines)
  math(EXPR _jw_lineno "${_jw_lineno} + 1")
  string(SUBSTRING "${_jw_raw}" 1 -1 _jw_line)
  string(STRIP "${_jw_line}" _jw_line)
  if(_jw_line STREQUAL "" OR _jw_line MATCHES "^#")
    continue()
  endif()
  set(_jw_rest "${_jw_line}")
  set(_jw_nsep 0)
  foreach(_jw_k RANGE 1 3)
    string(FIND "${_jw_rest}" " | " _jw_p)
    if(_jw_p EQUAL -1)
      break()
    endif()
    string(SUBSTRING "${_jw_rest}" 0 ${_jw_p} _jw_f)
    string(STRIP "${_jw_f}" _jw_field${_jw_k})
    math(EXPR _jw_p "${_jw_p} + 3")
    string(SUBSTRING "${_jw_rest}" ${_jw_p} -1 _jw_rest)
    set(_jw_nsep ${_jw_k})
  endforeach()
  string(STRIP "${_jw_rest}" _jw_rest)
  if(_jw_nsep EQUAL 2)
    set(_jw_field3 "${_jw_rest}")
    set(_jw_field4 "")
  elseif(_jw_nsep EQUAL 3)
    set(_jw_field4 "${_jw_rest}")
  else()
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: expected NAME | EXIT | EXPECTED | ARGS")
  endif()
  if(NOT _jw_field1 MATCHES "^[A-Za-z0-9._-]+(@posix)?$")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: bad case name '${_jw_field1}'")
  endif()
  if(_jw_field1 IN_LIST _jw_names)
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: duplicate case name '${_jw_field1}'")
  endif()
  if(NOT _jw_field2 MATCHES "^[0-9]+$")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: bad exit code '${_jw_field2}'")
  endif()
  if(_jw_field3 STREQUAL "")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: empty expectation")
  endif()
  if(_jw_field3 MATCHES "^[?]")
    message(FATAL_ERROR "cases.txt:${_jw_lineno}: no \"?\" prefix: an ERR line must be on stdout")
  endif()
  if(_jw_field3 MATCHES "^@(.+)$")
    set(_jw_f "${CASES_DIR}/${CMAKE_MATCH_1}")
    if(NOT EXISTS "${_jw_f}")
      message(FATAL_ERROR "cases.txt:${_jw_lineno}: '${_jw_f}' not found")
    endif()
    file(READ "${_jw_f}" _jw_json)
    string(JSON _jw_t ERROR_VARIABLE _jw_e TYPE "${_jw_json}")
    if(NOT _jw_e STREQUAL "NOTFOUND" OR NOT _jw_t STREQUAL "OBJECT")
      message(FATAL_ERROR "cases.txt:${_jw_lineno}: '${_jw_f}' is not a JSON object: ${_jw_e}")
    endif()
  endif()
  list(APPEND _jw_names "${_jw_field1}")
  set(_jw_case${_jw_count}_name "${_jw_field1}")
  set(_jw_case${_jw_count}_exit "${_jw_field2}")
  set(_jw_case${_jw_count}_expect "${_jw_field3}")
  set(_jw_case${_jw_count}_args "${_jw_field4}")
  set(_jw_case${_jw_count}_line "${_jw_lineno}")
  math(EXPR _jw_count "${_jw_count} + 1")
endforeach()
if(_jw_count EQUAL 0)
  message(FATAL_ERROR "cases.txt: no cases")
endif()

# ------------------------------------------------------------------------------------------------
# helpers

# Decodes one ARGS token: "" is the empty string, %XX a byte, ${NAME} a JW_VAR_NAME value.
function(_jw_decode out token line)
  if(token STREQUAL "\"\"")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  set(res "")
  set(rest "${token}")
  while(1)
    string(FIND "${rest}" "%" p)
    if(p EQUAL -1)
      string(APPEND res "${rest}")
      break()
    endif()
    string(SUBSTRING "${rest}" 0 ${p} pre)
    string(APPEND res "${pre}")
    math(EXPR q "${p} + 1")
    string(SUBSTRING "${rest}" ${q} 2 hex)
    if(NOT hex MATCHES "^[0-9A-Fa-f][0-9A-Fa-f]$")
      message(FATAL_ERROR "cases.txt:${line}: bad escape in '${token}'")
    endif()
    math(EXPR code "0x${hex}")
    if(code EQUAL 0)
      message(FATAL_ERROR "cases.txt:${line}: %00 cannot be passed as an argument")
    endif()
    string(ASCII ${code} ch)
    string(APPEND res "${ch}")
    math(EXPR q "${p} + 3")
    string(SUBSTRING "${rest}" ${q} -1 rest)
  endwhile()
  foreach(var IN LISTS JW_VARS)
    string(REPLACE "\${${var}}" "${JW_VAR_${var}}" res "${res}")
  endforeach()
  string(FIND "${res}" "\${" p)
  if(NOT p EQUAL -1)
    message(FATAL_ERROR "cases.txt:${line}: unknown variable in '${token}'")
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Runs JW_CHECK with _jw_a0 .. _jw_a<argc-1>; sets _jw_rc, _jw_out and _jw_err.
function(_jw_exec argc)
  set(o WORKING_DIRECTORY "${CASES_DIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err
        TIMEOUT ${JW_CASE_TIMEOUT} ENCODING UTF-8)
  set(c "${JW_CHECK}")
  if(argc EQUAL 0)
    execute_process(COMMAND "${c}" ${o})
  elseif(argc EQUAL 1)
    execute_process(COMMAND "${c}" "${_jw_a0}" ${o})
  elseif(argc EQUAL 2)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" ${o})
  elseif(argc EQUAL 3)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" ${o})
  elseif(argc EQUAL 4)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" ${o})
  elseif(argc EQUAL 5)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" "${_jw_a4}" ${o})
  elseif(argc EQUAL 6)
    execute_process(COMMAND "${c}" "${_jw_a0}" "${_jw_a1}" "${_jw_a2}" "${_jw_a3}" "${_jw_a4}"
                            "${_jw_a5}" ${o})
  else()
    message(FATAL_ERROR "run-cases.cmake: more than 6 arguments")
  endif()
  set(_jw_rc "${rc}" PARENT_SCOPE)
  set(_jw_out "${out}" PARENT_SCOPE)
  set(_jw_err "${err}" PARENT_SCOPE)
endfunction()

function(_jw_short out text)
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE "\n" " / " text "${text}")
  string(LENGTH "${text}" n)
  if(n GREATER 160)
    string(SUBSTRING "${text}" 0 160 text)
    string(APPEND text "...")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Sets <out> to "" when <text> matches the expectation (literal or ~regex), else to a reason.
function(_jw_match out text expect)
  if(expect MATCHES "^~(.*)$")
    set(re "${CMAKE_MATCH_1}")
    if(text MATCHES "${re}")
      set(${out} "" PARENT_SCOPE)
    else()
      set(${out} "does not match /${re}/" PARENT_SCOPE)
    endif()
  elseif(text STREQUAL expect)
    set(${out} "" PARENT_SCOPE)
  else()
    set(${out} "expected '${expect}'" PARENT_SCOPE)
  endif()
endfunction()

# First difference between two JSON values (expected, actual) as "<pointer>: <reason>".
function(_jw_json_diff out exp act ptr)
  string(JSON te TYPE "${exp}")
  string(JSON ta TYPE "${act}")
  if(NOT te STREQUAL ta)
    _jw_short(se "${exp}")
    _jw_short(sa "${act}")
    set(${out} "${ptr}: expected ${te} ${se}, got ${ta} ${sa}" PARENT_SCOPE)
    return()
  endif()
  if(te STREQUAL "OBJECT")
    foreach(side IN ITEMS exp act)
      if(side STREQUAL "exp")
        set(a "${exp}")
        set(b "${act}")
        set(why "missing")
      else()
        set(a "${act}")
        set(b "${exp}")
        set(why "unexpected member")
      endif()
      string(JSON n LENGTH "${a}")
      if(n GREATER 0)
        math(EXPR last "${n} - 1")
        foreach(i RANGE ${last})
          string(JSON k MEMBER "${a}" ${i})
          string(JSON t ERROR_VARIABLE e TYPE "${b}" "${k}")
          if(NOT e STREQUAL "NOTFOUND")
            set(${out} "${ptr}/${k}: ${why}" PARENT_SCOPE)
            return()
          endif()
        endforeach()
      endif()
    endforeach()
    string(JSON n LENGTH "${exp}")
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      string(JSON k MEMBER "${exp}" ${i})
      _jw_json_child_diff(d "${exp}" "${act}" "${k}" "${ptr}/${k}")
      if(NOT d STREQUAL "")
        set(${out} "${d}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  elseif(te STREQUAL "ARRAY")
    string(JSON ne LENGTH "${exp}")
    string(JSON na LENGTH "${act}")
    set(n ${ne})
    if(na LESS ne)
      set(n ${na})
    endif()
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      foreach(i RANGE ${last})
        _jw_json_child_diff(d "${exp}" "${act}" "${i}" "${ptr}/${i}")
        if(NOT d STREQUAL "")
          set(${out} "${d}" PARENT_SCOPE)
          return()
        endif()
      endforeach()
    endif()
    if(NOT ne EQUAL na)
      set(${out} "${ptr}: expected ${ne} items, got ${na}" PARENT_SCOPE)
      return()
    endif()
  endif()
  set(${out} "${ptr}: values differ" PARENT_SCOPE)
endfunction()

function(_jw_json_child_diff out exp act key ptr)
  string(JSON te TYPE "${exp}" "${key}")
  string(JSON ta TYPE "${act}" "${key}")
  string(JSON ve GET "${exp}" "${key}")
  string(JSON va GET "${act}" "${key}")
  if(te STREQUAL ta AND (te STREQUAL "OBJECT" OR te STREQUAL "ARRAY"))
    string(JSON eq EQUAL "${ve}" "${va}")
    if(eq)
      set(${out} "" PARENT_SCOPE)
    else()
      _jw_json_diff(d "${ve}" "${va}" "${ptr}")
      set(${out} "${d}" PARENT_SCOPE)
    endif()
  elseif(te STREQUAL ta AND ve STREQUAL va)
    set(${out} "" PARENT_SCOPE)
  else()
    _jw_short(se "${ve}")
    _jw_short(sa "${va}")
    set(${out} "${ptr}: expected ${te} '${se}', got ${ta} '${sa}'" PARENT_SCOPE)
  endif()
endfunction()

# ------------------------------------------------------------------------------------------------
# run

set(_jw_reserved COMMAND WORKING_DIRECTORY TIMEOUT RESULT_VARIABLE RESULTS_VARIABLE OUTPUT_VARIABLE
    ERROR_VARIABLE INPUT_FILE OUTPUT_FILE ERROR_FILE OUTPUT_QUIET ERROR_QUIET COMMAND_ECHO
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE ENCODING ECHO_OUTPUT_VARIABLE
    ECHO_ERROR_VARIABLE COMMAND_ERROR_IS_FATAL)

message(NOTICE "jw-cases: JW_CHECK=${JW_CHECK}")
message(NOTICE "jw-cases: WORK_DIR=${WORK_DIR}")
set(_jw_pass 0)
set(_jw_fail 0)
set(_jw_skip 0)
set(_jw_failed "")
math(EXPR _jw_last "${_jw_count} - 1")
foreach(_jw_i RANGE ${_jw_last})
  set(_jw_name "${_jw_case${_jw_i}_name}")
  set(_jw_line "${_jw_case${_jw_i}_line}")
  if(DEFINED JW_CASES_FILTER AND NOT _jw_name MATCHES "${JW_CASES_FILTER}")
    continue()
  endif()
  if(CMAKE_HOST_WIN32 AND _jw_name MATCHES "@posix$")
    message(NOTICE "SKIP ${_jw_name} (POSIX only: an argument is not UTF-8 or is a POSIX device)")
    math(EXPR _jw_skip "${_jw_skip} + 1")
    continue()
  endif()

  # arguments
  set(_jw_argc 0)
  string(REGEX REPLACE " +" ";" _jw_tokens "${_jw_case${_jw_i}_args}")
  foreach(_jw_tok IN LISTS _jw_tokens)
    if(_jw_tok STREQUAL "")
      continue()
    endif()
    _jw_decode(_jw_a${_jw_argc} "${_jw_tok}" "${_jw_line}")
    if(_jw_a${_jw_argc} IN_LIST _jw_reserved)
      message(FATAL_ERROR "cases.txt:${_jw_line}: argument '${_jw_tok}' is an execute_process keyword")
    endif()
    math(EXPR _jw_argc "${_jw_argc} + 1")
  endforeach()

  _jw_exec(${_jw_argc})
  string(REGEX REPLACE "[\r\n]+$" "" _jw_stdout "${_jw_out}")
  set(_jw_expect "${_jw_case${_jw_i}_expect}")

  set(_jw_why "")
  set(_jw_detail "")
  if(NOT "${_jw_rc}" STREQUAL "${_jw_case${_jw_i}_exit}")
    set(_jw_why "exit ${_jw_rc}, expected ${_jw_case${_jw_i}_exit}")
  endif()
  if(_jw_expect STREQUAL "*")
    set(_jw_detail "exit ${_jw_rc}")
  elseif(_jw_expect MATCHES "^@(.+)$")
    file(READ "${CASES_DIR}/${CMAKE_MATCH_1}" _jw_want)
    string(STRIP "${_jw_out}" _jw_o)
    string(LENGTH "${_jw_o}" _jw_n)
    set(_jw_first "")
    set(_jw_lastc "")
    if(_jw_n GREATER 0)
      string(SUBSTRING "${_jw_o}" 0 1 _jw_first)
      math(EXPR _jw_k "${_jw_n} - 1")
      string(SUBSTRING "${_jw_o}" ${_jw_k} 1 _jw_lastc)
    endif()
    set(_jw_jwhy "")
    if(NOT _jw_first STREQUAL "{" OR NOT _jw_lastc STREQUAL "}")
      set(_jw_jwhy "stdout is not exactly one JSON object")
    else()
      string(JSON _jw_eq ERROR_VARIABLE _jw_e EQUAL "${_jw_want}" "${_jw_o}")
      if(NOT _jw_e STREQUAL "NOTFOUND")
        set(_jw_jwhy "stdout is not JSON: ${_jw_e}")
      elseif(NOT _jw_eq)
        _jw_json_diff(_jw_d "${_jw_want}" "${_jw_o}" "")
        set(_jw_jwhy "JSON differs at ${_jw_d}")
      endif()
    endif()
    if(_jw_jwhy STREQUAL "")
      set(_jw_detail "exit ${_jw_rc}, JSON equal to ${CMAKE_MATCH_1}")
    else()
      _jw_short(_jw_s "${_jw_out}")
      list(APPEND _jw_why "${_jw_jwhy}" "stdout '${_jw_s}'")
    endif()
  else()
    _jw_match(_jw_m "${_jw_stdout}" "${_jw_expect}")
    # One line only: an ERR line never comes with JSON or other output (contract r2 item 11).
    if(_jw_m STREQUAL "" AND _jw_stdout MATCHES "[\r\n]")
      set(_jw_m "is more than one line")
    endif()
    _jw_short(_jw_s "${_jw_stdout}")
    if(_jw_m STREQUAL "")
      set(_jw_detail "exit ${_jw_rc}, ${_jw_s}")
    else()
      list(APPEND _jw_why "stdout '${_jw_s}' ${_jw_m}")
    endif()
  endif()

  if(_jw_why STREQUAL "")
    message(NOTICE "PASS ${_jw_name} (${_jw_detail})")
    math(EXPR _jw_pass "${_jw_pass} + 1")
  else()
    _jw_short(_jw_s "${_jw_err}")
    if(NOT _jw_s STREQUAL "")
      list(APPEND _jw_why "stderr '${_jw_s}'")
    endif()
    list(JOIN _jw_why "; " _jw_why)
    message(NOTICE "FAIL ${_jw_name} (${_jw_why}) cases.txt:${_jw_line}")
    math(EXPR _jw_fail "${_jw_fail} + 1")
    list(APPEND _jw_failed "${_jw_name}")
  endif()
endforeach()

math(EXPR _jw_total "${_jw_pass} + ${_jw_fail} + ${_jw_skip}")
message(NOTICE "jw-cases: ${_jw_pass} passed, ${_jw_fail} failed, ${_jw_skip} skipped, ${_jw_total} run")
if(_jw_fail GREATER 0)
  list(JOIN _jw_failed " " _jw_failed)
  message(FATAL_ERROR "jw-cases: failed: ${_jw_failed}")
endif()
