# r2.9: stored-shape files over 64 MiB (hard links to files generated by run-cases.cmake): a collection,
# user.ini, a profile service.json (its .bak is small) and a module config, next to a collection of
# exactly 64 MiB and small files.
hardlink scenes/obs-studio/basic/scenes/Big.json ${WORK}/plan-gen/collection-64mib-plus-1.json
hardlink scenes/obs-studio/basic/scenes/Max.json ${WORK}/plan-gen/collection-64mib.json
copy scenes/obs-studio/basic/scenes/Small.json fixtures/plan/files/small.json
hardlink user/obs-studio/user.ini ${WORK}/plan-gen/collection-64mib-plus-1.json
file profiles/obs-studio/basic/profiles/P/basic.ini 100
hardlink profiles/obs-studio/basic/profiles/P/service.json ${WORK}/plan-gen/collection-64mib-plus-1.json
file profiles/obs-studio/basic/profiles/P/service.json.bak 30
hardlink config/obs-studio/plugin_config/obs-websocket/config.json ${WORK}/plan-gen/collection-64mib-plus-1.json
