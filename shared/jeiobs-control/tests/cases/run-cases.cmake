# ------------------------------------------------------------------------------------------------
# cases.txt

file(READ "${CASES_DIR}/cases.txt" _jc_text)
string(REPLACE "\r" "" _jc_text "${_jc_text}")
foreach(_jc_bad IN ITEMS semicolon backslash)
  set(_jc_ch_semicolon ";")
  set(_jc_ch_backslash "\\")
  string(FIND "${_jc_text}" "${_jc_ch_${_jc_bad}}" _jc_pos)
  if(NOT _jc_pos EQUAL -1)
    message(FATAL_ERROR "cases.txt: no ${_jc_bad} allowed (byte offset ${_jc_pos}), use %XX")
  endif()
endforeach()
# Square brackets would stop the list split below at the line ends: they travel as %5B and %5D,
# which EXPECTED and ARGS decode.
string(REPLACE "[" "%5B" _jc_text "${_jc_text}")
string(REPLACE "]" "%5D" _jc_text "${_jc_text}")
# Every line gets a ">" prefix so that empty lines stay list elements and line numbers hold.
string(REPLACE "\n" ";>" _jc_lines ">${_jc_text}")

# Absolute paths of the FILEs of a "=FILE,FILE" or "@FILE,FILE" expectation, relative to CASES_DIR.
function(_jc_expect_files out spec line)
  string(REPLACE "," ";" names "${spec}")
  set(files "")
  foreach(n IN LISTS names)
    set(f "${CASES_DIR}/${n}")
    if(NOT EXISTS "${f}" OR IS_DIRECTORY "${f}")
      message(FATAL_ERROR "cases.txt:${line}: '${n}' not found")
    endif()
    list(APPEND files "${f}")
  endforeach()
  set(${out} "${files}" PARENT_SCOPE)
endfunction()

set(_jc_count 0)
set(_jc_names "")
set(_jc_lineno 0)
foreach(_jc_raw IN LISTS _jc_lines)
  math(EXPR _jc_lineno "${_jc_lineno} + 1")
  string(SUBSTRING "${_jc_raw}" 1 -1 _jc_line)
  string(STRIP "${_jc_line}" _jc_line)
  if(_jc_line STREQUAL "" OR _jc_line MATCHES "^#")
    continue()
  endif()
  set(_jc_rest "${_jc_line}")
  set(_jc_nsep 0)
  foreach(_jc_k RANGE 1 3)
    string(FIND "${_jc_rest}" " | " _jc_p)
    if(_jc_p EQUAL -1)
      break()
    endif()
    string(SUBSTRING "${_jc_rest}" 0 ${_jc_p} _jc_f)
    string(STRIP "${_jc_f}" _jc_field${_jc_k})
    math(EXPR _jc_p "${_jc_p} + 3")
    string(SUBSTRING "${_jc_rest}" ${_jc_p} -1 _jc_rest)
    set(_jc_nsep ${_jc_k})
  endforeach()
  string(STRIP "${_jc_rest}" _jc_rest)
  if(_jc_nsep EQUAL 2)
    set(_jc_field3 "${_jc_rest}")
    set(_jc_field4 "")
  elseif(_jc_nsep EQUAL 3)
    set(_jc_field4 "${_jc_rest}")
  else()
    message(FATAL_ERROR "cases.txt:${_jc_lineno}: expected NAME | EXIT | EXPECTED | ARGS")
  endif()
  if(NOT _jc_field1 MATCHES "^[A-Za-z0-9._-]+(@posix)?$")
    message(FATAL_ERROR "cases.txt:${_jc_lineno}: bad case name '${_jc_field1}'")
  endif()
  if(_jc_field1 IN_LIST _jc_names)
    message(FATAL_ERROR "cases.txt:${_jc_lineno}: duplicate case name '${_jc_field1}'")
  endif()
  if(NOT _jc_field2 MATCHES "^[0-9]+(,[0-9]+)*$")
    message(FATAL_ERROR "cases.txt:${_jc_lineno}: bad exit code '${_jc_field2}'")
  endif()
  if(_jc_field3 STREQUAL "")
    message(FATAL_ERROR "cases.txt:${_jc_lineno}: empty expectation")
  endif()
  set(_jc_files "")
  if(_jc_field3 MATCHES "^([=@])(.+)$")
    _jc_expect_files(_jc_files "${CMAKE_MATCH_2}" ${_jc_lineno})
    if(_jc_field3 MATCHES "^@")
      foreach(_jc_f IN LISTS _jc_files)
        file(READ "${_jc_f}" _jc_json)
        string(JSON _jc_t ERROR_VARIABLE _jc_e TYPE "${_jc_json}")
        if(NOT _jc_e STREQUAL "NOTFOUND" OR NOT _jc_t STREQUAL "OBJECT")
          message(FATAL_ERROR "cases.txt:${_jc_lineno}: '${_jc_f}' is not a JSON object: ${_jc_e}")
        endif()
      endforeach()
    endif()
  endif()
  list(APPEND _jc_names "${_jc_field1}")
  set(_jc_case${_jc_count}_name "${_jc_field1}")
  set(_jc_case${_jc_count}_exit "${_jc_field2}")
  set(_jc_case${_jc_count}_expect "${_jc_field3}")
  set(_jc_case${_jc_count}_files "${_jc_files}")
  set(_jc_case${_jc_count}_args "${_jc_field4}")
  set(_jc_case${_jc_count}_line "${_jc_lineno}")
  math(EXPR _jc_count "${_jc_count} + 1")
endforeach()
if(_jc_count EQUAL 0)
  message(FATAL_ERROR "cases.txt: no cases")
endif()

# ------------------------------------------------------------------------------------------------
# helpers

# Decodes %XX bytes of a token (%00 is refused). With <vars> TRUE, "" is the empty string and
# ${NAME} a JC_VAR_NAME value.
function(_jc_decode out token line vars)
  if(vars AND token STREQUAL "\"\"")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  set(res "")
  set(rest "${token}")
  while(1)
    string(FIND "${rest}" "%" p)
    if(p EQUAL -1)
      string(APPEND res "${rest}")
      break()
    endif()
    string(SUBSTRING "${rest}" 0 ${p} pre)
    string(APPEND res "${pre}")
    math(EXPR q "${p} + 1")
    string(SUBSTRING "${rest}" ${q} 2 hex)
    if(NOT hex MATCHES "^[0-9A-Fa-f][0-9A-Fa-f]$")
      message(FATAL_ERROR "cases.txt:${line}: bad escape in '${token}'")
    endif()
    math(EXPR code "0x${hex}")
    if(code EQUAL 0)
      message(FATAL_ERROR "cases.txt:${line}: %00 cannot be passed")
    endif()
    string(ASCII ${code} ch)
    string(APPEND res "${ch}")
    math(EXPR q "${p} + 3")
    string(SUBSTRING "${rest}" ${q} -1 rest)
  endwhile()
  if(vars)
    foreach(var IN LISTS JC_VARS)
      string(REPLACE "\${${var}}" "${JC_VAR_${var}}" res "${res}")
    endforeach()
    string(FIND "${res}" "\${" p)
    if(NOT p EQUAL -1)
      message(FATAL_ERROR "cases.txt:${line}: unknown variable in '${token}'")
    endif()
  endif()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Runs JC_CHECK with _jc_a0 .. _jc_a<argc-1>; sets _jc_rc, _jc_out and _jc_err.
function(_jc_exec argc)
  set(o WORKING_DIRECTORY "${CASES_DIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err
        TIMEOUT ${JC_CASE_TIMEOUT} ENCODING UTF-8)
  set(c "${JC_CHECK}")
  if(argc EQUAL 0)
    execute_process(COMMAND "${c}" ${o})
  elseif(argc EQUAL 1)
    execute_process(COMMAND "${c}" "${_jc_a0}" ${o})
  elseif(argc EQUAL 2)
    execute_process(COMMAND "${c}" "${_jc_a0}" "${_jc_a1}" ${o})
  elseif(argc EQUAL 3)
    execute_process(COMMAND "${c}" "${_jc_a0}" "${_jc_a1}" "${_jc_a2}" ${o})
  elseif(argc EQUAL 4)
    execute_process(COMMAND "${c}" "${_jc_a0}" "${_jc_a1}" "${_jc_a2}" "${_jc_a3}" ${o})
  elseif(argc EQUAL 5)
    execute_process(COMMAND "${c}" "${_jc_a0}" "${_jc_a1}" "${_jc_a2}" "${_jc_a3}" "${_jc_a4}" ${o})
  elseif(argc EQUAL 6)
    execute_process(COMMAND "${c}" "${_jc_a0}" "${_jc_a1}" "${_jc_a2}" "${_jc_a3}" "${_jc_a4}"
                            "${_jc_a5}" ${o})
  else()
    message(FATAL_ERROR "run-cases.cmake: more than 6 arguments")
  endif()
  set(_jc_rc "${rc}" PARENT_SCOPE)
  set(_jc_out "${out}" PARENT_SCOPE)
  set(_jc_err "${err}" PARENT_SCOPE)
endfunction()

function(_jc_short out text)
  string(REPLACE "\r" "" text "${text}")
  string(REPLACE "\n" " / " text "${text}")
  string(LENGTH "${text}" n)
  if(n GREATER 160)
    string(SUBSTRING "${text}" 0 160 text)
    string(APPEND text "...")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# Sets <out> to "" when <text> matches the expectation (literal or ~regex), else to a reason.
function(_jc_match out text expect)
  if(expect MATCHES "^~(.*)$")
    set(re "${CMAKE_MATCH_1}")
    if(text MATCHES "${re}")
      set(${out} "" PARENT_SCOPE)
    else()
      set(${out} "does not match /${re}/" PARENT_SCOPE)
    endif()
  elseif(text STREQUAL expect)
    set(${out} "" PARENT_SCOPE)
  else()
    set(${out} "expected '${expect}'" PARENT_SCOPE)
  endif()
endfunction()

# The first byte where <got> differs from <want>, with some context (binary search on prefixes).
function(_jc_first_diff out want got)
  string(LENGTH "${want}" lw)
  string(LENGTH "${got}" lg)
  set(lo 0)
  set(hi ${lw})
  if(lg LESS lw)
    set(hi ${lg})
  endif()
  while(lo LESS hi)
    math(EXPR mid "(${lo} + ${hi} + 1) / 2")
    string(SUBSTRING "${want}" 0 ${mid} x)
    string(SUBSTRING "${got}" 0 ${mid} y)
    if(x STREQUAL y)
      set(lo ${mid})
    else()
      math(EXPR hi "${mid} - 1")
    endif()
  endwhile()
  set(s ${lo})
  if(s GREATER 24)
    math(EXPR s "${lo} - 24")
  else()
    set(s 0)
  endif()
  string(SUBSTRING "${want}" ${s} 72 cw)
  string(SUBSTRING "${got}" ${s} 72 cg)
  set(${out} "first difference at byte ${lo} of ${lg} (want ${lw}): expected '...${cw}', got '...${cg}'"
      PARENT_SCOPE)
endfunction()

# First difference between two JSON values (expected, actual) as "<pointer>: <reason>".
function(_jc_json_diff out exp act ptr)
  string(JSON te TYPE "${exp}")
  string(JSON ta TYPE "${act}")
  if(NOT te STREQUAL ta)
    _jc_short(se "${exp}")
    _jc_short(sa "${act}")
    set(${out} "${ptr}: expected ${te} ${se}, got ${ta} ${sa}" PARENT_SCOPE)
    return()
  endif()
  if(te STREQUAL "OBJECT")
    foreach(side IN ITEMS exp act)
      if(side STREQUAL "exp")
        set(a "${exp}")
        set(b "${act}")
        set(why "missing")
      else()
        set(a "${act}")
        set(b "${exp}")
        set(why "unexpected member")
      endif()
      string(JSON n LENGTH "${a}")
      if(n GREATER 0)
        math(EXPR last "${n} - 1")
        foreach(i RANGE ${last})
          string(JSON k MEMBER "${a}" ${i})
          string(JSON t ERROR_VARIABLE e TYPE "${b}" "${k}")
          if(NOT e STREQUAL "NOTFOUND")
            set(${out} "${ptr}/${k}: ${why}" PARENT_SCOPE)
            return()
          endif()
        endforeach()
      endif()
    endforeach()
    string(JSON n LENGTH "${exp}")
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      foreach(i RANGE ${last})
        string(JSON k MEMBER "${exp}" ${i})
        _jc_json_child_diff(d "${exp}" "${act}" "${k}" "${ptr}/${k}")
        if(NOT d STREQUAL "")
          set(${out} "${d}" PARENT_SCOPE)
          return()
        endif()
      endforeach()
    endif()
  elseif(te STREQUAL "ARRAY")
    string(JSON ne LENGTH "${exp}")
    string(JSON na LENGTH "${act}")
    set(n ${ne})
    if(na LESS ne)
      set(n ${na})
    endif()
    if(n GREATER 0)
      math(EXPR last "${n} - 1")
      foreach(i RANGE ${last})
        _jc_json_child_diff(d "${exp}" "${act}" "${i}" "${ptr}/${i}")
        if(NOT d STREQUAL "")
          set(${out} "${d}" PARENT_SCOPE)
          return()
        endif()
      endforeach()
    endif()
    if(NOT ne EQUAL na)
      set(${out} "${ptr}: expected ${ne} items, got ${na}" PARENT_SCOPE)
      return()
    endif()
  endif()
  set(${out} "${ptr}: values differ" PARENT_SCOPE)
endfunction()

function(_jc_json_child_diff out exp act key ptr)
  string(JSON te TYPE "${exp}" "${key}")
  string(JSON ta TYPE "${act}" "${key}")
  string(JSON ve GET "${exp}" "${key}")
  string(JSON va GET "${act}" "${key}")
  if(te STREQUAL ta AND (te STREQUAL "OBJECT" OR te STREQUAL "ARRAY"))
    string(JSON eq EQUAL "${ve}" "${va}")
    if(eq)
      set(${out} "" PARENT_SCOPE)
    else()
      _jc_json_diff(d "${ve}" "${va}" "${ptr}")
      set(${out} "${d}" PARENT_SCOPE)
    endif()
  elseif(te STREQUAL ta AND ve STREQUAL va)
    set(${out} "" PARENT_SCOPE)
  else()
    _jc_short(se "${ve}")
    _jc_short(sa "${va}")
    set(${out} "${ptr}: expected ${te} '${se}', got ${ta} '${sa}'" PARENT_SCOPE)
  endif()
endfunction()

# Strips trailing CR and LF characters.
function(_jc_chomp out text)
  string(REGEX REPLACE "[\r\n]+$" "" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

# ------------------------------------------------------------------------------------------------
# run

set(_jc_reserved COMMAND WORKING_DIRECTORY TIMEOUT RESULT_VARIABLE RESULTS_VARIABLE OUTPUT_VARIABLE
    ERROR_VARIABLE INPUT_FILE OUTPUT_FILE ERROR_FILE OUTPUT_QUIET ERROR_QUIET COMMAND_ECHO
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE ENCODING ECHO_OUTPUT_VARIABLE
    ECHO_ERROR_VARIABLE COMMAND_ERROR_IS_FATAL)

message(NOTICE "jc-cases: JC_CHECK=${JC_CHECK}")
message(NOTICE "jc-cases: WORK_DIR=${WORK_DIR}")
set(_jc_pass 0)
set(_jc_fail 0)
set(_jc_skip 0)
set(_jc_failed "")
math(EXPR _jc_last "${_jc_count} - 1")
foreach(_jc_i RANGE ${_jc_last})
  set(_jc_name "${_jc_case${_jc_i}_name}")
  set(_jc_line "${_jc_case${_jc_i}_line}")
  if(DEFINED JC_CASES_FILTER AND NOT _jc_name MATCHES "${JC_CASES_FILTER}")
    continue()
  endif()
  if(CMAKE_HOST_WIN32 AND _jc_name MATCHES "@posix$")
    message(NOTICE "SKIP ${_jc_name} (POSIX only)")
    math(EXPR _jc_skip "${_jc_skip} + 1")
    continue()
  endif()

  set(_jc_argc 0)
  string(REGEX REPLACE " +" ";" _jc_tokens "${_jc_case${_jc_i}_args}")
  foreach(_jc_tok IN LISTS _jc_tokens)
    if(_jc_tok STREQUAL "")
      continue()
    endif()
    _jc_decode(_jc_a${_jc_argc} "${_jc_tok}" "${_jc_line}" TRUE)
    if(_jc_a${_jc_argc} IN_LIST _jc_reserved)
      message(FATAL_ERROR "cases.txt:${_jc_line}: argument '${_jc_tok}' is an execute_process keyword")
    endif()
    math(EXPR _jc_argc "${_jc_argc} + 1")
  endforeach()

  _jc_exec(${_jc_argc})
  _jc_chomp(_jc_stdout "${_jc_out}")
  set(_jc_expect "${_jc_case${_jc_i}_expect}")
  if(NOT _jc_expect MATCHES "^[=@]")
    _jc_decode(_jc_expect "${_jc_expect}" "${_jc_line}" FALSE)
  endif()

  set(_jc_why "")
  set(_jc_detail "")
  string(REPLACE "," ";" _jc_exits "${_jc_case${_jc_i}_exit}")
  if(NOT "${_jc_rc}" IN_LIST _jc_exits)
    set(_jc_why "exit ${_jc_rc}, expected ${_jc_case${_jc_i}_exit}")
  endif()
  # An OK line comes with exit 0, an ERR line with exit 1, and JSON output with exit 0.
  if(NOT _jc_expect STREQUAL "*")
    if(_jc_stdout MATCHES "^OK( |$)" AND NOT "${_jc_rc}" STREQUAL "0")
      list(APPEND _jc_why "an OK line with exit ${_jc_rc}")
    elseif(_jc_stdout MATCHES "^ERR " AND NOT "${_jc_rc}" STREQUAL "1")
      list(APPEND _jc_why "an ERR line with exit ${_jc_rc}")
    elseif(_jc_stdout MATCHES "^{" AND NOT "${_jc_rc}" STREQUAL "0")
      list(APPEND _jc_why "JSON output with exit ${_jc_rc}")
    endif()
  endif()
  if(_jc_expect STREQUAL "*")
    set(_jc_detail "exit ${_jc_rc}")
  elseif(_jc_expect MATCHES "^=")
    # stdout is exactly the bytes of one of the files (trailing CR and LF removed)
    set(_jc_hit "")
    foreach(_jc_f IN LISTS _jc_case${_jc_i}_files)
      file(READ "${_jc_f}" _jc_want)
      _jc_chomp(_jc_want "${_jc_want}")
      if(_jc_stdout STREQUAL _jc_want)
        file(RELATIVE_PATH _jc_hit "${CASES_DIR}" "${_jc_f}")
        break()
      endif()
    endforeach()
    if(NOT _jc_hit STREQUAL "")
      set(_jc_detail "exit ${_jc_rc}, stdout = ${_jc_hit}")
    else()
      list(GET _jc_case${_jc_i}_files 0 _jc_f)
      file(READ "${_jc_f}" _jc_want)
      _jc_chomp(_jc_want "${_jc_want}")
      file(RELATIVE_PATH _jc_fn "${CASES_DIR}" "${_jc_f}")
      _jc_first_diff(_jc_d "${_jc_want}" "${_jc_stdout}")
      list(APPEND _jc_why "stdout is not the bytes of ${_jc_fn}: ${_jc_d}")
    endif()
    if(_jc_stdout MATCHES "[\r\n]")
      list(APPEND _jc_why "stdout is more than one line")
    endif()
  elseif(_jc_expect MATCHES "^@")
    # stdout is one JSON object equal to one of the files
    string(STRIP "${_jc_out}" _jc_o)
    set(_jc_jwhy "")
    if(NOT _jc_o MATCHES "^{.*}$")
      set(_jc_jwhy "stdout is not exactly one JSON object")
    else()
      string(JSON _jc_t ERROR_VARIABLE _jc_e TYPE "${_jc_o}")
      if(NOT _jc_e STREQUAL "NOTFOUND")
        set(_jc_jwhy "stdout is not JSON: ${_jc_e}")
      endif()
    endif()
    set(_jc_hit "")
    if(_jc_jwhy STREQUAL "")
      foreach(_jc_f IN LISTS _jc_case${_jc_i}_files)
        file(READ "${_jc_f}" _jc_want)
        string(JSON _jc_eq EQUAL "${_jc_want}" "${_jc_o}")
        if(_jc_eq)
          file(RELATIVE_PATH _jc_hit "${CASES_DIR}" "${_jc_f}")
          break()
        endif()
      endforeach()
      if(_jc_hit STREQUAL "")
        list(GET _jc_case${_jc_i}_files 0 _jc_f)
        file(READ "${_jc_f}" _jc_want)
        file(RELATIVE_PATH _jc_fn "${CASES_DIR}" "${_jc_f}")
        _jc_json_diff(_jc_d "${_jc_want}" "${_jc_o}" "")
        set(_jc_jwhy "JSON differs from ${_jc_fn} at ${_jc_d}")
      endif()
    endif()
    if(_jc_jwhy STREQUAL "")
      set(_jc_detail "exit ${_jc_rc}, JSON equal to ${_jc_hit}")
    else()
      _jc_short(_jc_s "${_jc_out}")
      list(APPEND _jc_why "${_jc_jwhy}" "stdout '${_jc_s}'")
    endif()
  else()
    _jc_match(_jc_m "${_jc_stdout}" "${_jc_expect}")
    # One line only: an ERR line never comes with JSON or other output.
    if(_jc_m STREQUAL "" AND _jc_stdout MATCHES "[\r\n]")
      set(_jc_m "is more than one line")
    endif()
    _jc_short(_jc_s "${_jc_stdout}")
    if(_jc_m STREQUAL "")
      set(_jc_detail "exit ${_jc_rc}, ${_jc_s}")
    else()
      list(APPEND _jc_why "stdout '${_jc_s}' ${_jc_m}")
    endif()
  endif()

  if(_jc_why STREQUAL "")
    message(NOTICE "PASS ${_jc_name} (${_jc_detail})")
    math(EXPR _jc_pass "${_jc_pass} + 1")
  else()
    _jc_short(_jc_s "${_jc_err}")
    if(NOT _jc_s STREQUAL "")
      list(APPEND _jc_why "stderr '${_jc_s}'")
    endif()
    list(JOIN _jc_why "; " _jc_why)
    message(NOTICE "FAIL ${_jc_name} (${_jc_why}) cases.txt:${_jc_line}")
    math(EXPR _jc_fail "${_jc_fail} + 1")
    list(APPEND _jc_failed "${_jc_name}")
  endif()
endforeach()

math(EXPR _jc_total "${_jc_pass} + ${_jc_fail} + ${_jc_skip}")
message(NOTICE "jc-cases: ${_jc_pass} passed, ${_jc_fail} failed, ${_jc_skip} skipped, ${_jc_total} run")
if(_jc_fail GREATER 0)
  list(JOIN _jc_failed " " _jc_failed)
  message(FATAL_ERROR "jc-cases: failed: ${_jc_failed}")
endif()
