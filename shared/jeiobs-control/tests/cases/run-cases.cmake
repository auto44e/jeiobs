file(COPY_FILE "${CASES_DIR}/fixtures/valid/minimal.json" "${JC_VAR_UTF8_PATH}")

# value JSON arguments for the value helper (at most about 25,000 characters: the Windows command
# line holds 32,767)
set(JC_VAR_WORK "${WORK_DIR}")
string(REPEAT "a" 4096 _jc_x)
set(JC_VAR_V_TEXT_4096 "{\"type\":\"text\",\"value\":\"${_jc_x}\"}")
set(JC_VAR_V_TEXT_4097 "{\"type\":\"text\",\"value\":\"${_jc_x}a\"}")
