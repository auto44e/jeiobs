# Black-box cases for jc-check, the jeiobs-control command-line checker (task 006, K1-PR1).
#
#   cmake -DJC_CHECK=<jc-check> -DCASES_DIR=<this directory> -DWORK_DIR=<scratch directory>
#         [-DJC_CASES_FILTER=<regex on case names>] [-DJC_CASE_TIMEOUT=<seconds>] -P run-cases.cmake
#
# Generates the large and byte-level inputs into WORK_DIR, runs every case of cases.txt (the format
# is documented at the top of that file) and prints one "PASS|FAIL|SKIP <case> (<detail>)" line per
# case and a summary. Fails if any case fails. The expected values were written from
# docs/jeiobs/tasks/006-control-protocols.md and the K1-PR1 contract, not from the implementation.
# Plain CMake: no shell, no Python. WORK_DIR is only written to, never cleaned; it needs about 15 MB.

cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED JC_CASE_TIMEOUT)
  set(JC_CASE_TIMEOUT 120)
endif()

foreach(_jc_var IN ITEMS JC_CHECK CASES_DIR WORK_DIR)
  if(NOT DEFINED ${_jc_var} OR "${${_jc_var}}" STREQUAL "")
    message(FATAL_ERROR "run-cases.cmake: pass -D${_jc_var}=<path>")
  endif()
  get_filename_component(${_jc_var} "${${_jc_var}}" ABSOLUTE)
endforeach()
if(NOT EXISTS "${JC_CHECK}" OR IS_DIRECTORY "${JC_CHECK}")
  message(FATAL_ERROR "run-cases.cmake: JC_CHECK '${JC_CHECK}' is not a file")
endif()
if(NOT EXISTS "${CASES_DIR}/cases.txt")
  message(FATAL_ERROR "run-cases.cmake: '${CASES_DIR}/cases.txt' not found")
endif()
file(MAKE_DIRECTORY "${WORK_DIR}")

# ------------------------------------------------------------------------------------------------
# Generated inputs. None contains a newline, because file(WRITE) may translate newlines on
# Windows; every file is checked for its exact size after writing.

function(_jc_write name content)
  file(WRITE "${WORK_DIR}/${name}" "${content}")
  string(LENGTH "${content}" _want)
  file(SIZE "${WORK_DIR}/${name}" _have)
  if(NOT _have EQUAL _want)
    message(FATAL_ERROR "run-cases.cmake: wrote ${_have} bytes to ${name}, expected ${_want}")
  endif()
endfunction()

function(_jc_check_hex name regex what)
  file(READ "${WORK_DIR}/${name}" _x HEX)
  if(NOT _x MATCHES "${regex}")
    message(FATAL_ERROR "run-cases.cmake: ${name} lacks ${what}")
  endif()
endfunction()

string(JSON _jc_nul GET [=[["\u0000"]]=] 0) # one NUL byte; string(ASCII) cannot produce it
string(ASCII 195 169 _jc_e_acute) # U+00E9 in UTF-8
string(ASCII 239 187 191 _jc_bom)
string(ASCII 255 _jc_ff)

# A minimal valid mapping, one line: _jc_pre, a target id, _jc_post.
set(_jc_head [=[{"format":"jeiobs-control","major":1,"minor":0,]=])
set(_jc_slots [=["slots":[{"id":"main_surface","requires":["mcu.fader"]}],]=])
set(_jc_route_start [=[{"id":"r1","enabled":true,"match":{"slot":"main_surface","address":[{"s":"mcu"},{"i":0},{"s":"fader"}]},"target":{"kind":"mixer","id":"]=])
set(_jc_route_end [=[","field":"volume"}}]=])
set(_jc_pre "${_jc_head}${_jc_slots}\"routes\":[${_jc_route_start}")
set(_jc_post "${_jc_route_end}]}")
set(_jc_m "${_jc_pre}mic${_jc_post}")

# file size: the minimal mapping padded with blanks between members to 4 MiB and 4 MiB + 1
string(LENGTH "${_jc_m}" _jc_len)
foreach(_jc_size IN ITEMS 4194304 4194305)
  math(EXPR _jc_pad "${_jc_size} - ${_jc_len}")
  string(REPEAT " " ${_jc_pad} _jc_x)
  _jc_write(size-${_jc_size}.json "${_jc_head}${_jc_x}${_jc_slots}\"routes\":[${_jc_route_start}mic${_jc_post}")
endforeach()

# depth: the top-level object is depth 1, so N nested empty arrays in a member reach depth N + 1
foreach(_jc_n IN ITEMS 31 32 99999)
  string(REPEAT "[" ${_jc_n} _jc_o)
  string(REPEAT "]" ${_jc_n} _jc_c)
  math(EXPR _jc_d "${_jc_n} + 1")
  _jc_write(depth-${_jc_d}.json "${_jc_head}\"x_deep\":${_jc_o}${_jc_c},${_jc_slots}\"routes\":[${_jc_route_start}mic${_jc_post}")
endforeach()
string(REPEAT "{\"a\":" 31 _jc_o)
string(REPEAT "}" 31 _jc_c)
_jc_write(depth-33-objects.json "${_jc_head}\"x_deep\":${_jc_o}{}${_jc_c},${_jc_slots}\"routes\":[${_jc_route_start}mic${_jc_post}")

# Appends <count> generated items (built by <macro>(index) into _jc_item) to <out>, comma separated,
# in chunks so the growing string is not copied once per item.
macro(_jc_items out first last builder)
  set(${out} "")
  set(_jc_chunk "")
  foreach(_jc_i RANGE ${first} ${last})
    cmake_language(CALL ${builder} ${_jc_i})
    if(_jc_i EQUAL ${first})
      string(APPEND _jc_chunk "${_jc_item}")
    else()
      string(APPEND _jc_chunk ",${_jc_item}")
    endif()
    math(EXPR _jc_r "${_jc_i} % 256")
    if(_jc_r EQUAL 0)
      string(APPEND ${out} "${_jc_chunk}")
      set(_jc_chunk "")
    endif()
  endforeach()
  string(APPEND ${out} "${_jc_chunk}")
endmacro()

set(_jc_route_null [=[{"id":"r1","enabled":true,"match":{"slot":null,"address":[{"s":"mcu"}]},"target":{"kind":"scene","id":"s"}}]=])

# slot count: 256 and 257 slots
macro(_jc_slot_item i)
  set(_jc_item "{\"id\":\"s${i}\",\"requires\":[]}")
endmacro()
_jc_items(_jc_all 1 256 _jc_slot_item)
_jc_write(slots-256.json "${_jc_head}\"slots\":[${_jc_all}],\"routes\":[${_jc_route_null}]}")
_jc_write(slots-257.json "${_jc_head}\"slots\":[${_jc_all},{\"id\":\"s257\",\"requires\":[]}],\"routes\":[${_jc_route_null}]}")

# route count: 10,000 and 10,001 routes g1.., each to its own scene
macro(_jc_route_item i)
  set(_jc_item "{\"id\":\"g${i}\",\"enabled\":true,\"match\":{\"slot\":null,\"address\":[{\"s\":\"g\"},{\"i\":${i}}]},\"target\":{\"kind\":\"scene\",\"id\":\"s${i}\"}}")
endmacro()
_jc_items(_jc_all 1 10000 _jc_route_item)
_jc_write(routes-10000.json "${_jc_head}\"slots\":[],\"routes\":[${_jc_all}]}")
_jc_route_item(10001)
_jc_write(routes-10001.json "${_jc_head}\"slots\":[],\"routes\":[${_jc_all},${_jc_item}]}")

# bounded time: 10,000 routes f1.. with a 64-wide set each (fan-out 64, under 4 MiB)
set(_jc_set "0")
foreach(_jc_i RANGE 1 63)
  string(APPEND _jc_set ",${_jc_i}")
endforeach()
macro(_jc_fan_item i)
  set(_jc_item "{\"id\":\"f${i}\",\"enabled\":true,\"match\":{\"slot\":null,\"address\":[{\"s\":\"f\"},{\"i\":${i}},{\"in\":[${_jc_set}]}]},\"target\":{\"kind\":\"scene\",\"id\":\"s${i}\"}}")
endmacro()
_jc_items(_jc_all 1 10000 _jc_fan_item)
_jc_write(perf-fanout-10000.json "${_jc_head}\"slots\":[],\"routes\":[${_jc_all}]}")
file(SIZE "${WORK_DIR}/perf-fanout-10000.json" _jc_x)
if(NOT _jc_x LESS 4194304)
  message(FATAL_ERROR "run-cases.cmake: perf-fanout-10000.json is over 4 MiB")
endif()

# 10,000 emit routes c1 -> c2 -> ... -> c10000: an open chain, and closed into one cycle
macro(_jc_chain_item i)
  math(EXPR _jc_next "${i} + 1")
  set(_jc_item "{\"id\":\"c${i}\",\"enabled\":true,\"match\":{\"slot\":null,\"address\":[{\"s\":\"c\"},{\"i\":${i}}]},\"target\":{\"kind\":\"emit\",\"address\":[{\"s\":\"c\"},{\"i\":${_jc_next}}]}}")
endmacro()
_jc_items(_jc_all 1 9999 _jc_chain_item)
_jc_chain_item(10000)
_jc_write(perf-chain-10000.json "${_jc_head}\"slots\":[],\"routes\":[${_jc_all},${_jc_item}]}")
string(REPLACE "{\"i\":10001}" "{\"i\":1}" _jc_item "${_jc_item}")
_jc_write(perf-cycle-10000.json "${_jc_head}\"slots\":[],\"routes\":[${_jc_all},${_jc_item}]}")
unset(_jc_all)

# byte-level parser faults, in the target id unless named otherwise
set(_jc_utf8_ff 255)
set(_jc_utf8_80 128)
set(_jc_utf8_overlong 192 175) # overlong "/"
set(_jc_utf8_surrogate 237 160 128) # U+D800
set(_jc_utf8_above-10ffff 244 144 128 128) # U+110000
set(_jc_utf8_truncated 195) # lead byte, then the closing quote
foreach(_jc_k IN ITEMS ff 80 overlong surrogate above-10ffff truncated)
  string(ASCII ${_jc_utf8_${_jc_k}} _jc_b)
  if(_jc_k STREQUAL "truncated")
    _jc_write(utf8-${_jc_k}.json "${_jc_pre}a${_jc_b}${_jc_post}")
  else()
    _jc_write(utf8-${_jc_k}.json "${_jc_pre}a${_jc_b}b${_jc_post}")
  endif()
endforeach()
_jc_write(utf8-key.json "${_jc_head}\"x_${_jc_ff}\":1,${_jc_slots}\"routes\":[${_jc_route_start}mic${_jc_post}")
_jc_write(utf8-unknown-member.json "${_jc_head}\"x_extra\":\"a${_jc_ff}b\",${_jc_slots}\"routes\":[${_jc_route_start}mic${_jc_post}")
# NUL bytes, built at this scope (string(REPLACE) and set(PARENT_SCOPE) cut a value at its NUL)
set(_jc_x "${_jc_pre}a${_jc_nul}b${_jc_post}")
file(WRITE "${WORK_DIR}/nul-in-string.json" "${_jc_x}")
_jc_check_hex(nul-in-string.json "^.*22610062222c.*$" "its NUL byte") # "a<NUL>b",
set(_jc_x "${_jc_m}${_jc_nul}")
file(WRITE "${WORK_DIR}/nul-trailing.json" "${_jc_x}")
_jc_check_hex(nul-trailing.json "^.*7d00$" "its NUL byte")
_jc_write(bom.json "${_jc_bom}${_jc_m}")
_jc_write(bom-after-space.json " ${_jc_bom}${_jc_m}")
_jc_write(bom-event.json "${_jc_bom}{\"slot\":null,\"address\":[{\"s\":\"mcu\"},{\"i\":0},{\"s\":\"fader\"}]}")
_jc_write(empty.json "")
_jc_write(whitespace.json " \t ")

# paths: a space, and non-ASCII directory and file names (UTF-8 arguments)
file(MAKE_DIRECTORY "${WORK_DIR}/with space" "${WORK_DIR}/caf${_jc_e_acute}")
file(COPY_FILE "${CASES_DIR}/fixtures/valid/minimal.json" "${WORK_DIR}/with space/minimal.json")
